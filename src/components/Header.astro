---
const navLinks = [
  { name: 'MAGAZINE', href: '/magazine' },
  { name: 'PROGETTI', href: '/progetti' },
  { name: 'PARTNERSHIP', href: '/partnership' },
  { name: 'CALENDARIO', href: '/calendar' },
  { name: 'TEAM', href: '/team' },
  { name: 'CONTATTI', href: '/contatti' },
];

const leftLinks = navLinks.slice(0, 3);
const rightLinks = navLinks.slice(3);

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-50 bg-zero-bg w-full border-b border-black/[0.04]">
  <div class="w-full px-4 sm:px-8 lg:px-12 max-w-[1600px] mx-auto">
    <!-- Desktop Navigation: 3-column grid with centered larger logo -->
    <div class="hidden md:grid md:grid-cols-[1fr_auto_1fr] items-center py-1.5 lg:py-2 gap-4 lg:gap-8 min-h-[58px] lg:min-h-[66px]">
      <!-- Left Navigation Links (MAGAZINE, PROGETTI, PARTNERSHIP) -->
      <nav class="flex items-center space-x-5 lg:space-x-8 justify-start" aria-label="Navigazione Sinistra">
        {leftLinks.map((link) => {
          const isActive = currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href));
          return (
            <a
              href={link.href}
              class={`group flex items-center ui-meta text-sm lg:text-[15px] tracking-wider transition-colors duration-200 ${
                isActive ? 'text-zero-red font-bold' : 'text-zero-black font-semibold hover:text-zero-red'
              }`}
            >
              <span>{link.name}</span>
              <span class="ml-1.5 inline-block transition-transform duration-300 ease-out group-hover:translate-x-1">→</span>
            </a>
          );
        })}
      </nav>

      <!-- Center Logo (Ingrandito visivamente senza aumentare il padding dell'header) -->
      <div class="flex items-center justify-center px-4 sm:px-6 h-20 lg:h-24 overflow-visible">
        <a href="/" class="flex items-center justify-center h-full group focus:outline-none overflow-visible" aria-label="VERACE Home">
          <img
            src="/logos/Verace_Logo_Nero.png"
            alt="VERACE Logo"
            class="h-[46px] sm:h-[52px] md:h-[58px] lg:h-[66px] w-auto object-contain scale-[1.55] sm:scale-[1.65] md:scale-[1.75] lg:scale-[1.85] origin-center transition-all duration-300 group-hover:opacity-75"
          />
        </a>
      </div>

      <!-- Right Navigation Links (CALENDARIO, TEAM, CONTATTI) -->
      <nav class="flex items-center space-x-5 lg:space-x-8 justify-end" aria-label="Navigazione Destra">
        {rightLinks.map((link) => {
          const isActive = currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href));
          return (
            <a
              href={link.href}
              class={`group flex items-center ui-meta text-sm lg:text-[15px] tracking-wider transition-colors duration-200 ${
                isActive ? 'text-zero-red font-bold' : 'text-zero-black font-semibold hover:text-zero-red'
              }`}
            >
              <span>{link.name}</span>
              <span class="ml-1.5 inline-block transition-transform duration-300 ease-out group-hover:translate-x-1">→</span>
            </a>
          );
        })}
      </nav>
    </div>

    <!-- Mobile Header (Logo Centrato con hamburger a destra) -->
    <div class="md:hidden flex items-center justify-between h-14 py-1">
      <div class="w-10"></div> <!-- Spacer per centrare visivamente il logo -->

      <div class="flex items-center justify-center h-10 overflow-visible">
        <a href="/" class="flex items-center justify-center h-full focus:outline-none overflow-visible" aria-label="VERACE Home">
          <img
            src="/logos/Verace_Logo_Nero.png"
            alt="VERACE Logo"
            class="h-[36px] w-auto object-contain scale-[1.55] origin-center"
          />
        </a>
      </div>

      <div class="w-10 flex justify-end">
        <button
          id="mobile-menu-toggle"
          type="button"
          class="p-2 text-zero-black focus:outline-none"
          aria-controls="mobile-menu"
          aria-expanded="false"
          aria-label="Apri menu navigazione"
        >
          <svg id="menu-open-icon" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
          <svg id="menu-close-icon" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Drawer -->
  <div id="mobile-menu" class="hidden md:hidden bg-zero-bg px-6 py-6 space-y-4 border-b border-black/[0.06] shadow-sm">
    {navLinks.map((link) => {
      const isActive = currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href));
      return (
        <a
          href={link.href}
          class={`group flex items-center justify-between ui-meta py-3 border-b border-black/[0.04] transition-colors ${
            isActive ? 'text-zero-red font-bold' : 'text-zero-black hover:text-zero-red'
          }`}
        >
          <span>{link.name}</span>
          <span class="transition-transform duration-300 ease-out group-hover:translate-x-1">→</span>
        </a>
      );
    })}
  </div>
</header>

<script>
  function initMobileMenu() {
    const toggleBtn = document.getElementById('mobile-menu-toggle');
    const mobileMenu = document.getElementById('mobile-menu');
    const openIcon = document.getElementById('menu-open-icon');
    const closeIcon = document.getElementById('menu-close-icon');

    if (toggleBtn && mobileMenu && openIcon && closeIcon) {
      toggleBtn.onclick = () => {
        const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';
        toggleBtn.setAttribute('aria-expanded', (!isExpanded).toString());
        mobileMenu.classList.toggle('hidden');
        openIcon.classList.toggle('hidden');
        closeIcon.classList.toggle('hidden');
      };
    }
  }

  document.addEventListener('DOMContentLoaded', initMobileMenu);
  document.addEventListener('astro:page-load', initMobileMenu);
</script>
