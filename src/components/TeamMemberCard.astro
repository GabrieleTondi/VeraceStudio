---
import type { TeamMember } from '../lib/sanity';

interface Props {
  member: TeamMember;
  index?: number;
}

const { member, index = 0 } = Astro.props;

// Palette di loghi e sfondi con i colori ufficiali VERACE
const logoVariants = [
  {
    bg: 'bg-zero-red',
    logo: '/logos/Verace_Logo_Bianco.png',
    alt: 'Logo VERACE Bianco su Rosso',
  },
  {
    bg: 'bg-white',
    logo: '/logos/Verace_Logo_Nero.png',
    alt: 'Logo VERACE Nero',
  },
  {
    bg: 'bg-zero-black',
    logo: '/logos/Verace_Logo_Bianco.png',
    alt: 'Logo VERACE Bianco su Nero',
  },
  {
    bg: 'bg-zero-bg',
    logo: '/logos/Verace_Logo_Nero.png',
    alt: 'Logo VERACE Nero su Fondo Chiaro',
  },
];

const variant = logoVariants[index % logoVariants.length];
---

<article class="group flex flex-col space-y-4 relative w-full h-full bg-white/70 backdrop-blur-sm p-6 shadow-[0_4px_24px_rgba(55,50,50,0.03)] hover:shadow-[0_12px_32px_rgba(55,50,50,0.07)] hover:-translate-y-1 transition-all duration-300">
  
  {/* Foto Profilo del Membro o Box Logo Brand di fallback */}
  <div class={`relative w-full aspect-[4/5] ${member.photoUrl ? 'bg-neutral-100' : variant.bg} flex items-center justify-center overflow-hidden transition-transform duration-500 ease-out group-hover:scale-[1.02]`}>
    {member.photoUrl ? (
      <img
        src={member.photoUrl}
        alt={`Foto di ${member.name} - ${member.role}`}
        class="w-full h-full object-cover transition-transform duration-500 ease-out group-hover:scale-105"
        loading="lazy"
        decoding="async"
      />
    ) : (
      <div class="p-8 flex items-center justify-center w-full h-full">
        <img
          src={variant.logo}
          alt={`${member.name} - ${variant.alt}`}
          class="w-4/5 max-w-[170px] h-auto object-contain transition-transform duration-500 ease-out group-hover:scale-105"
          loading="lazy"
          decoding="async"
        />
      </div>
    )}
  </div>

  <div class="flex flex-col flex-grow pt-2 space-y-2">
    <div>
      <h3 class="font-display font-black text-xl uppercase text-zero-black group-hover:text-zero-red transition-colors leading-tight">
        {member.name}
      </h3>
      <div class="font-mono text-xs font-bold text-zero-red uppercase tracking-wider mt-1">
        {member.role}
      </div>
    </div>
    
    {member.bio && (
      <p class="text-sm font-light text-zero-black/85 leading-relaxed pt-1">
        {member.bio}
      </p>
    )}
  </div>
</article>
