---
import { type Project, urlFor } from '../lib/sanity';
import DownloadButton from './DownloadButton.astro';

interface Props {
  project: Project;
  compact?: boolean;
}

const { project, compact = false } = Astro.props;

const projectSlug = project.slug?.current || 'la-bela';
const projectUrl = `/progetti/progetto/${projectSlug}`;

let imageUrl = '/projects/LA BELA/IMG_4931.webp';
if (project.galleryUrls && project.galleryUrls.length > 0 && project.galleryUrls[0]) {
  imageUrl = project.galleryUrls[0];
} else if (project.gallery && project.gallery.length > 0 && project.gallery[0]) {
  imageUrl = project.gallery[0].asset?.url || (project.gallery[0].asset?._ref ? urlFor(project.gallery[0])?.url() : null) || imageUrl;
}

const statusColors = {
  'In Corso': 'bg-zero-red text-white border-zero-dark',
  'Concluso': 'bg-zero-dark text-white border-zero-dark',
  'In Programmazione': 'bg-zero-paper text-zero-black border-zero-dark'
};
---

<article class={`group bg-zero-paper flex flex-col ${compact ? 'md:flex-row' : ''} relative overflow-hidden`}>
  {/* Sezione Immagine */}
  <div class={`relative overflow-hidden ${compact ? 'md:w-1/3' : 'h-64'}`}>
    <a href={projectUrl} class="block w-full h-full overflow-hidden">
      <img
        src={imageUrl}
        alt={`Foto del progetto VERACE: ${project.title}`}
        class="w-full h-full object-cover grayscale transition-all duration-700 group-hover:grayscale-0 group-hover:scale-105"
        loading="lazy"
      />
    </a>
    <div class="absolute top-3 left-3">
      <span class={`px-2 py-1 ui-meta font-bold ${statusColors[project.status]}`}>
        {project.status}
      </span>
    </div>
  </div>

  {/* Dettagli Progetto */}
  <div class={`p-6 flex flex-col justify-between flex-grow ${compact ? 'md:w-2/3' : 'space-y-6'}`}>
    <div class="space-y-4">
      <h3 class="font-display font-bold text-2xl uppercase text-zero-black leading-tight group-hover:text-zero-granata transition-colors">
        <a href={projectUrl}>
          {project.title}
        </a>
      </h3>
      <p class="text-sm text-zero-black leading-relaxed line-clamp-3">
        {project.summary}
      </p>
      
      {project.partners && project.partners.length > 0 && (
        <div class="pt-4 border-t border-zero-lightborder">
          <div class="ui-meta text-zero-granata font-bold mb-2">PARTNERS STRATEGICI:</div>
          <div class="flex flex-wrap gap-2">
            {project.partners.map((partner) => (
              <span class="px-2 py-1 text-xs uppercase font-mono bg-zero-bg">
                {partner}
              </span>
            ))}
          </div>
        </div>
      )}
    </div>

    <div class="pt-4 border-t border-zero-dark flex items-center justify-between">
      <a
        href={projectUrl}
        class="ui-meta font-bold text-xs text-zero-granata flex items-center gap-1 hover:text-zero-black transition-colors"
      >
        SCHEDA PROGETTO COMPLETA →
      </a>
      {project.attachedDocUrl && (
        <a
          href={project.attachedDocUrl}
          download
          class="ui-meta font-bold text-xs text-zero-black hover:text-zero-granata transition-colors"
        >
          [ PDF ]
        </a>
      )}
    </div>
  </div>
</article>
