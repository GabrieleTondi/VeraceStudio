---
import { type Project, urlFor } from '../lib/sanity';

interface Props {
  project: Project;
  compact?: boolean;
}

const { project } = Astro.props;

const projectSlug = project.slug?.current || 'la-bela';
const projectUrl = `/progetti/progetto/${projectSlug}`;

let imageUrl = '/projects/LA BELA/IMG_4931.webp';
if (project.galleryUrls && project.galleryUrls.length > 0 && project.galleryUrls[0]) {
  imageUrl = project.galleryUrls[0];
} else if (project.gallery && project.gallery.length > 0 && project.gallery[0]) {
  imageUrl = project.gallery[0].asset?.url || (project.gallery[0].asset?._ref ? urlFor(project.gallery[0])?.url() : null) || imageUrl;
}
---

<article class="group bg-transparent flex flex-col relative overflow-hidden">
  <!-- Immagine di Copertina Progetto (Dimensione Rettangolare Classica h-64 sm:h-72) -->
  <div class="relative w-full h-64 sm:h-72 overflow-hidden bg-black/5">
    <a href={projectUrl} class="block w-full h-full overflow-hidden" aria-label={`Vai al progetto ${project.title}`}>
      <img
        src={imageUrl}
        alt={`Foto del progetto VERACE: ${project.title}`}
        class="w-full h-full object-cover grayscale transition-all duration-700 ease-out group-hover:grayscale-0 group-hover:scale-105"
        loading="lazy"
        decoding="async"
      />
    </a>
  </div>

  <!-- Dettagli Sotto la Foto: Titolo Piccolo e Sottotitolo/Summary Essenziale -->
  <div class="pt-4 space-y-1.5 flex-grow">
    <h3 class="font-display font-bold text-lg sm:text-xl uppercase text-zero-black leading-tight group-hover:text-zero-red transition-colors">
      <a href={projectUrl} class="focus:outline-none before:absolute before:inset-0">
        {project.title}
      </a>
    </h3>
    {project.summary && (
      <p class="text-xs sm:text-sm text-zero-black/70 font-light leading-relaxed line-clamp-2">
        {project.summary}
      </p>
    )}
  </div>
</article>

