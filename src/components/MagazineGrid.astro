---
import ArticleCard from './ArticleCard.astro';
import type { Post } from '../lib/sanity';

interface Props {
  posts: Post[];
  title?: string;
  subtitle?: string;
}

const { posts, title = 'MAGAZINE', subtitle = 'storie, racconti, reportage' } = Astro.props;
---

<section class="pt-0 pb-8 space-y-6 md:space-y-8">
  <div class="flex flex-col md:flex-row md:items-end justify-between pb-2 gap-6">
    <div>
      <h2 class="text-4xl md:text-5xl lg:text-6xl font-black font-display uppercase tracking-tight text-zero-black">{title}</h2>
      {subtitle && <p class="text-xs sm:text-sm font-mono text-zero-black/70 mt-1.5 lowercase tracking-wider">{subtitle}</p>}
    </div>
    <a href="/magazine" class="inline-flex items-center px-6 py-3 bg-zero-black text-white font-mono text-xs font-bold uppercase tracking-widest hover:bg-zero-red transition-colors shadow-sm">
      VEDI TUTTI GLI ARTICOLI →
    </a>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 md:gap-10 lg:gap-12">
    {posts.map((post) => (
      <ArticleCard post={post} />
    ))}
  </div>
</section>

