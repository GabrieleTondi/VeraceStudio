---
import ArticleCard from './ArticleCard.astro';
import type { Post } from '../lib/sanity';

interface Props {
  posts: Post[];
  title?: string;
  subtitle?: string;
}

const { posts, title = 'PUBBLICAZIONI & INCHIESTE', subtitle = 'ARCHIVIO EDITORIALE DI VERACE' } = Astro.props;
---

<section class="pt-0 pb-8">
  <div class="mb-8 flex flex-col md:flex-row md:items-end justify-between border-b-2 border-zero-black pb-4 gap-4">
    <div>
      <div class="text-xs font-mono font-bold text-zero-red uppercase tracking-widest mb-1">[ PUBBLICAZIONI ]</div>
      <h2 class="text-3xl md:text-4xl font-black font-display uppercase tracking-tight text-zero-black">{title}</h2>
      <p class="text-xs font-mono text-zero-muted mt-1 uppercase">{subtitle}</p>
    </div>
    <a href="/magazine" class="inline-flex items-center px-4 py-2 bg-zero-black text-white font-mono text-xs font-bold uppercase tracking-widest hover:bg-zero-red transition-colors border border-zero-black">
      VEDI TUTTI GLI ARTICOLI →
    </a>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
    {posts.map((post, index) => (
      <ArticleCard post={post} featured={index === 0} />
    ))}
  </div>
</section>
