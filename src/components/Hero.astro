---
import { FALLBACK_HERO_SLIDES, type HeroSlideItem } from '../lib/sanity';

export interface Props {
  slides?: HeroSlideItem[];
  headline?: string;
  primaryButtonText?: string;
  primaryButtonLink?: string;
  secondaryButtonText?: string;
  secondaryButtonLink?: string;
}

const {
  slides = FALLBACK_HERO_SLIDES,
  headline = "Media cultura e rigenerazione per il territorio",
  primaryButtonText = "scopri i progetti",
  primaryButtonLink = "/progetti",
  secondaryButtonText = "esplora il nostro magazine",
  secondaryButtonLink = "/magazine"
} = Astro.props;

// Assicura che le slides siano al massimo 9
const heroSlides = (slides && slides.length > 0 ? slides : FALLBACK_HERO_SLIDES).slice(0, 9);
---

<section
  id="hero-section"
  class="relative w-full h-[calc(100vh-4rem)] md:h-[calc(100vh-6rem)] overflow-hidden bg-zero-bg select-none"
  aria-label="Hero Slider VERACE"
>
  <!-- 1. CONTENITORE SLIDES SOVRAPPOSTE (FULL BLEED SENZA VIGNETTATURA) -->
  <div class="absolute inset-0 w-full h-full overflow-hidden">
    
    <!-- Slides sovrapposte una sopra l'altra (Stack fotografico) -->
    <div
      id="hero-slides-stack"
      class="relative w-full h-full will-change-transform"
      style="filter: grayscale(100%) saturate(0%);"
    >
      {heroSlides.map((slide, index) => (
        <div
          class={`hero-slide-layer absolute inset-0 w-full h-full overflow-hidden transition-opacity will-change-transform ${index === 0 ? 'opacity-100 z-10' : 'opacity-0 z-0'}`}
          data-slide-index={index}
        >
          <img
            src={slide.image}
            alt={slide.alt || slide.title || `VERACE Foto ${index + 1}`}
            class="hero-slide-img w-full h-full object-cover select-none will-change-transform"
            loading={index === 0 ? "eager" : "lazy"}
            decoding="async"
          />
          <!-- Dark Overlay per contrasto e leggibilità del testo -->
          <div class="absolute inset-0 bg-black/30 backdrop-brightness-95"></div>
        </div>
      ))}
    </div>

    <!-- Dissolvenza / Sbavatura Dinamica sul Bordo Inferiore (Vincolata allo Scroll) -->
    <div
      id="hero-bottom-scroll-fade"
      class="absolute bottom-0 left-0 right-0 h-[38px] pointer-events-none z-10 will-change-[opacity]"
      style="opacity: 0;"
      aria-hidden="true"
    >
      <div class="w-full h-full bg-gradient-to-t from-[#FFFCF9] via-[#FFFCF9]/80 to-transparent"></div>
    </div>
  </div>

  <!-- 2. LOGO CENTRALE VERACE (COMPARE NELL'INTRO E POI SVANISCE) -->
  <div
    id="hero-intro-logo"
    class="absolute inset-0 z-20 flex items-center justify-center pointer-events-none will-change-transform"
    style="opacity: 0; transform: scale(0.92);"
  >
    <img
      src="/logos/Verace_Logo_Bianco.png"
      alt="VERACE Logo"
      class="h-20 sm:h-28 md:h-36 lg:h-44 w-auto object-contain drop-shadow-[0_8px_32px_rgba(0,0,0,0.8)]"
    />
  </div>

  <!-- 3. TESTO E DUE BOTTONI CHE SUBENTRANO AL POSTO DEL LOGO AL CENTRO -->
  <div
    id="hero-center-content"
    class="absolute inset-0 z-20 flex flex-col items-center justify-center text-center px-4 sm:px-6 pointer-events-auto will-change-transform"
    style="opacity: 0; transform: scale(0.96) translateY(12px);"
  >
    <div class="max-w-4xl mx-auto space-y-6 md:space-y-8">
      
      <!-- Dicitura Sostitutiva al Logo -->
      <h1 class="text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-display font-bold uppercase tracking-tight text-white drop-shadow-[0_4px_24px_rgba(0,0,0,0.9)] leading-tight max-w-3xl mx-auto">
        {headline}
      </h1>

      <!-- Due Bottoni Affiancati al Centro -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 pt-2">
        <a
          href={primaryButtonLink}
          class="inline-flex items-center justify-center bg-zero-red text-white hover:bg-white hover:text-zero-black transition-all duration-300 px-8 py-4 font-mono font-bold text-xs uppercase tracking-wider shadow-lg hover:shadow-xl w-full sm:w-auto text-center"
        >
          {primaryButtonText}
        </a>
        <a
          href={secondaryButtonLink}
          class="inline-flex items-center justify-center bg-black/40 backdrop-blur-md text-white hover:bg-white hover:text-zero-black transition-all duration-300 px-8 py-4 font-mono font-bold text-xs uppercase tracking-wider shadow-lg hover:shadow-xl w-full sm:w-auto text-center"
        >
          {secondaryButtonText}
        </a>
      </div>

    </div>
  </div>

  <!-- 4. CONTROLLI DI NAVIGAZIONE SLIDER POST-INTRO (FRECCE E DOTS IN BASSO) -->
  {heroSlides.length > 1 && (
    <div
      id="hero-controls"
      class="absolute inset-x-0 bottom-6 sm:bottom-8 z-30 flex items-center justify-between px-4 sm:px-8 max-w-7xl mx-auto pointer-events-none opacity-0 transition-opacity duration-700"
    >
      <!-- Frecce Prev / Next Senza Sfondo -->
      <div class="flex items-center gap-3 pointer-events-auto">
        <button
          id="hero-prev-btn"
          type="button"
          class="text-white hover:text-zero-red bg-transparent p-2 transition-all duration-300 cursor-pointer focus:outline-none hover:scale-125 drop-shadow-[0_2px_8px_rgba(0,0,0,0.9)]"
          aria-label="Foto precedente"
        >
          <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7" />
          </svg>
        </button>

        <button
          id="hero-next-btn"
          type="button"
          class="text-white hover:text-zero-red bg-transparent p-2 transition-all duration-300 cursor-pointer focus:outline-none hover:scale-125 drop-shadow-[0_2px_8px_rgba(0,0,0,0.9)]"
          aria-label="Foto successiva"
        >
          <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
          </svg>
        </button>
      </div>

      <!-- Indicatori Dots Fluttuanti -->
      <div class="flex items-center gap-2.5 bg-transparent pointer-events-auto drop-shadow-[0_2px_6px_rgba(0,0,0,0.9)]">
        {heroSlides.map((_, index) => (
          <button
            type="button"
            class={`hero-nav-dot w-2.5 h-2.5 rounded-full transition-all duration-300 cursor-pointer focus:outline-none ${index === 0 ? 'bg-zero-red scale-125' : 'bg-white/60 hover:bg-white'}`}
            data-dot-index={index}
            aria-label={`Slide ${index + 1}`}
          />
        ))}
      </div>
    </div>
  )}
</section>

<script>
  import { gsap } from "gsap";

  function initHeroSlider() {
    const stack = document.getElementById('hero-slides-stack');
    const slideLayers = document.querySelectorAll<HTMLElement>('.hero-slide-layer');
    const introLogo = document.getElementById('hero-intro-logo');
    const centerContent = document.getElementById('hero-center-content');
    const controls = document.getElementById('hero-controls');
    const prevBtn = document.getElementById('hero-prev-btn');
    const nextBtn = document.getElementById('hero-next-btn');
    const dots = document.querySelectorAll<HTMLElement>('.hero-nav-dot');
    const totalSlides = slideLayers.length;

    if (!stack || totalSlides === 0 || !introLogo || !centerContent) return;

    let currentSlide = 0;
    let isIntroActive = true;
    let autoplayTimer: number | null = null;
    const slideInterval = 5000; // 5 secondi per slide in modalità regolare

    function showSlideInstant(index: number) {
      slideLayers.forEach((layer, idx) => {
        if (idx === index) {
          layer.style.opacity = '1';
          layer.style.zIndex = '10';
        } else {
          layer.style.opacity = '0';
          layer.style.zIndex = '0';
        }
      });
    }

    // -------------------------------------------------------------
    // 1. ANIMAZIONE INTRO REVEAL (SOLO ALLA PRIMA APERTURA DEL SITO)
    // -------------------------------------------------------------
    const hasSeenIntro = sessionStorage.getItem('verace_intro_seen') === 'true';

    if (hasSeenIntro) {
      // Navigazione di ritorno: mostra subito la schermata finale stabile (Slide 0)
      isIntroActive = false;
      showSlideInstant(0);
      stack.style.filter = 'grayscale(0%) saturate(100%)';
      if (introLogo) introLogo.style.display = 'none';
      if (centerContent) {
        centerContent.style.opacity = '1';
        centerContent.style.transform = 'scale(1) translateY(0)';
      }
      if (controls) {
        controls.classList.remove('opacity-0');
        controls.classList.add('opacity-100');
      }
      if (totalSlides > 1) {
        startAutoplay();
      }
    } else {
      // Prima apertura del sito nella sessione: salva il flag ed esegui la sequenza
      sessionStorage.setItem('verace_intro_seen', 'true');

      // Genera la sequenza di scatti dinamica in base al numero di slide (max 9)
      // Garantendo che l'ultima dell'animazione sia SEMPRE la prima foto (indice 0)
      function buildShutterSequence(count: number) {
        if (count <= 1) {
          return [{ time: 0.00, slide: 0 }];
        }

        const timePoints = [
          0.00, 0.12, 0.24, 0.36, 0.48, 0.62, 0.78, 0.96, 
          1.18, 1.44, 1.76, 2.14, 2.60, 3.16, 3.80
        ];

        const seq: { time: number; slide: number }[] = [];
        let slideCursor = 0;

        for (let i = 0; i < timePoints.length; i++) {
          // L'ultimo scatto a t = 3.80s deve cadere SEMPRE sulla slide 0
          if (i === timePoints.length - 1) {
            seq.push({ time: timePoints[i], slide: 0 });
          } else {
            seq.push({ time: timePoints[i], slide: slideCursor % count });
            slideCursor++;
          }
        }

        return seq;
      }

      const shutterSequence = buildShutterSequence(totalSlides);

      const introTl = gsap.timeline({
        onComplete: () => {
          isIntroActive = false;
          // Mostra i controlli interattivi (frecce e dots)
          if (controls) {
            controls.classList.remove('opacity-0');
            controls.classList.add('opacity-100');
          }
          // Avvia autoplay regolare se più di una slide
          if (totalSlides > 1) {
            startAutoplay();
          }
        }
      });

      // A) Sequenza di scatti a raffica sovrapposti
      shutterSequence.forEach(({ time, slide }) => {
        introTl.call(() => {
          showSlideInstant(slide);
          const img = slideLayers[slide].querySelector<HTMLElement>('.hero-slide-img');
          if (img) {
            gsap.fromTo(img, { scale: 1.03 }, { scale: 1.0, duration: 0.25, ease: "power1.out" });
          }
        }, [], time);
      });

      // B) Desaturazione progressiva verso il colore naturale (B&W 100% -> Colore 100%)
      introTl.to(stack, {
        filter: "grayscale(0%) saturate(100%)",
        duration: 4.0,
        ease: "power2.inOut"
      }, 0);

      // C) Logo VERACE: Compare dolcemente al centro (0.3s -> 1.8s)
      introTl.to(introLogo, {
        opacity: 1,
        scale: 1,
        duration: 1.5,
        ease: "power2.out"
      }, 0.3);

      // D) Logo VERACE: Svanisce al centro (2.3s -> 3.1s)
      introTl.to(introLogo, {
        opacity: 0,
        scale: 0.94,
        duration: 0.8,
        ease: "power2.in",
        onComplete: () => {
          if (introLogo) introLogo.style.display = 'none';
        }
      }, 2.3);

      // E) Testo e Due Bottoni: Compaiono in maniera fluida al posto del logo (3.0s -> 4.2s)
      introTl.to(centerContent, {
        opacity: 1,
        scale: 1,
        y: 0,
        duration: 1.2,
        ease: "power2.out"
      }, 3.0);
    }

    // -------------------------------------------------------------
    // 2. SLIDER FOTOGRAFICO REGOLARE (POST-INTRO)
    // -------------------------------------------------------------
    function transitionToSlide(targetIndex: number) {
      if (isIntroActive || totalSlides <= 1) return;

      if (targetIndex < 0) targetIndex = totalSlides - 1;
      if (targetIndex >= totalSlides) targetIndex = 0;

      const prevIndex = currentSlide;
      currentSlide = targetIndex;

      // Crossfade fotografico fluido tra le slide sovrapposte
      slideLayers.forEach((layer, idx) => {
        if (idx === currentSlide) {
          layer.style.zIndex = '10';
          gsap.fromTo(layer, 
            { opacity: 0 }, 
            { opacity: 1, duration: 0.8, ease: "power2.inOut" }
          );
          const img = layer.querySelector<HTMLElement>('.hero-slide-img');
          if (img) {
            gsap.fromTo(img, { scale: 1.03 }, { scale: 1.0, duration: 1.2, ease: "power2.out" });
          }
        } else if (idx === prevIndex) {
          layer.style.zIndex = '5';
          gsap.to(layer, { opacity: 0, duration: 0.8, ease: "power2.inOut" });
        } else {
          layer.style.zIndex = '0';
          layer.style.opacity = '0';
        }
      });

      // Aggiorna Dots indicatori
      dots.forEach((dot, idx) => {
        if (idx === currentSlide) {
          dot.classList.remove('bg-white/60');
          dot.classList.add('bg-zero-red', 'scale-125');
        } else {
          dot.classList.remove('bg-zero-red', 'scale-125');
          dot.classList.add('bg-white/60');
        }
      });
    }

    function interruptIntroIfActive() {
      if (isIntroActive) {
        isIntroActive = false;
        gsap.killTweensOf([stack, introLogo, centerContent]);
        if (stack) stack.style.filter = "grayscale(0%) saturate(100%)";
        if (introLogo) introLogo.style.opacity = "0";
        if (centerContent) {
          centerContent.style.opacity = "1";
          centerContent.style.transform = "scale(1) translateY(0)";
        }
        if (controls) {
          controls.classList.remove('opacity-0');
          controls.classList.add('opacity-100');
        }
      }
    }

    function nextSlide() {
      interruptIntroIfActive();
      transitionToSlide(currentSlide + 1);
    }

    function prevSlide() {
      interruptIntroIfActive();
      transitionToSlide(currentSlide - 1);
    }

    function startAutoplay() {
      if (totalSlides <= 1) return;
      stopAutoplay();
      autoplayTimer = window.setInterval(nextSlide, slideInterval);
    }

    function stopAutoplay() {
      if (autoplayTimer) {
        clearInterval(autoplayTimer);
        autoplayTimer = null;
      }
    }

    // Event Listener Controlli a Schermo (Frecce Prev / Next)
    if (nextBtn) {
      nextBtn.addEventListener('click', () => {
        nextSlide();
        startAutoplay();
      });
    }

    if (prevBtn) {
      prevBtn.addEventListener('click', () => {
        prevSlide();
        startAutoplay();
      });
    }

    dots.forEach((dot) => {
      dot.addEventListener('click', () => {
        interruptIntroIfActive();
        const target = parseInt(dot.getAttribute('data-dot-index') || '0', 10);
        transitionToSlide(target);
        startAutoplay();
      });
    });

    // Navigazione da Tastiera tramite Freccette Sinistra / Destra
    const handleKeyboardNav = (e: KeyboardEvent) => {
      const activeTag = document.activeElement?.tagName;
      if (activeTag === 'INPUT' || activeTag === 'TEXTAREA' || (document.activeElement as HTMLElement)?.isContentEditable) {
        return;
      }

      if (e.key === 'ArrowRight' || e.key === 'Right') {
        nextSlide();
        startAutoplay();
      } else if (e.key === 'ArrowLeft' || e.key === 'Left') {
        prevSlide();
        startAutoplay();
      }
    };

    window.addEventListener('keydown', handleKeyboardNav);

    // Pausa su hover
    const heroSection = document.getElementById('hero-section');
    if (heroSection) {
      heroSection.addEventListener('mouseenter', stopAutoplay);
      heroSection.addEventListener('mouseleave', () => {
        if (!isIntroActive && totalSlides > 1) startAutoplay();
      });
    }

    // Touch Swipe Mobile
    let touchStartX = 0;
    let touchEndX = 0;

    heroSection?.addEventListener('touchstart', (e) => {
      touchStartX = e.changedTouches[0].screenX;
      stopAutoplay();
    }, { passive: true });

    heroSection?.addEventListener('touchend', (e) => {
      touchEndX = e.changedTouches[0].screenX;
      const diff = touchStartX - touchEndX;
      if (Math.abs(diff) > 40) {
        if (diff > 0) nextSlide();
        else prevSlide();
      }
      if (!isIntroActive && totalSlides > 1) startAutoplay();
    }, { passive: true });

    // -------------------------------------------------------------
    // 3. DISSOLVENZA / SBAVATURA SUL BORDO INFERIORE LEGATA ALLO SCROLL
    // -------------------------------------------------------------
    const scrollFade = document.getElementById('hero-bottom-scroll-fade');
    if (scrollFade) {
      let isTicking = false;
      const scrollRange = 75; // 0px - 75px per passare da opacità 0 a 1

      const handleScroll = () => {
        if (!isTicking) {
          window.requestAnimationFrame(() => {
            const currentScroll = window.scrollY || window.pageYOffset || 0;
            const progress = Math.min(1, Math.max(0, currentScroll / scrollRange));
            scrollFade.style.opacity = progress.toFixed(3);
            isTicking = false;
          });
          isTicking = true;
        }
      };

      window.addEventListener('scroll', handleScroll, { passive: true });
      handleScroll(); // Controllo immediato allo stato iniziale
    }
  }

  document.addEventListener('DOMContentLoaded', initHeroSlider);
  document.addEventListener('astro:page-load', initHeroSlider);
</script>
