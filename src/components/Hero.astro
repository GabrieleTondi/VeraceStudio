---
import { FALLBACK_HERO_SLIDES, type HeroSlideItem } from '../lib/sanity';

export interface Props {
  slides?: HeroSlideItem[];
  headline?: string;
  primaryButtonText?: string;
  primaryButtonLink?: string;
  secondaryButtonText?: string;
  secondaryButtonLink?: string;
}

const {
  slides = FALLBACK_HERO_SLIDES,
  headline = "Media cultura e rigenerazione per il territorio",
  primaryButtonText = "scopri i progetti",
  primaryButtonLink = "/progetti",
  secondaryButtonText = "esplora il nostro magazine",
  secondaryButtonLink = "/magazine"
} = Astro.props;

// Assicura che le slides siano al massimo 9
const heroSlides = (slides && slides.length > 0 ? slides : FALLBACK_HERO_SLIDES).slice(0, 9);
---

<section
  id="hero-section"
  class="relative w-full bg-zero-bg pt-3 sm:pt-5 md:pt-6 pb-8 sm:pb-12 md:pb-16 select-none"
  aria-label="Hero VERACE"
>
  <!-- 1. RIQUADRO FOTOGRAFICO A TUTTA LARGHEZZA, CON ALTEZZA CALIBRATA PER IL DESKTOP -->
  <div class="relative w-full h-[44vh] sm:h-[48vh] md:h-[52vh] lg:h-[56vh] min-h-[260px] max-h-[560px] overflow-hidden bg-black/5 shadow-sm">
    
    <!-- Slides sovrapposte una sopra l'altra (Stack fotografico) -->
    <div
      id="hero-slides-stack"
      class="relative w-full h-full will-change-transform"
      style="filter: grayscale(100%) saturate(0%);"
    >
      {heroSlides.map((slide, index) => (
        <div
          class={`hero-slide-layer absolute inset-0 w-full h-full overflow-hidden transition-opacity will-change-transform ${index === 0 ? 'opacity-100 z-10' : 'opacity-0 z-0'}`}
          data-slide-index={index}
        >
          <img
            src={slide.image}
            alt={slide.alt || slide.title || `VERACE Foto ${index + 1}`}
            class="hero-slide-img w-full h-full object-cover select-none will-change-transform"
            loading={index === 0 ? "eager" : "lazy"}
            decoding="async"
          />
        </div>
      ))}
    </div>

    <!-- Logo VERACE durante intro (compare e svanisce nello scatto) -->
    <div
      id="hero-intro-logo"
      class="absolute inset-0 z-20 flex items-center justify-center pointer-events-none will-change-transform"
      style="opacity: 0; transform: scale(0.92);"
    >
      <img
        src="/logos/Verace_Logo_Bianco.png"
        alt="VERACE Logo"
        class="h-14 sm:h-20 md:h-28 w-auto object-contain drop-shadow-[0_8px_32px_rgba(0,0,0,0.8)]"
      />
    </div>

    <!-- FRECCE DIREZIONALI ESSENZIALI (PREV / NEXT) -->
    {heroSlides.length > 1 && (
      <div
        id="hero-controls"
        class="absolute inset-x-0 bottom-3 sm:bottom-5 md:bottom-6 z-30 flex items-center justify-end px-4 sm:px-8 md:px-12 pointer-events-none opacity-0 transition-opacity duration-700"
      >
        <div class="flex items-center gap-2 pointer-events-auto bg-black/40 backdrop-blur-sm px-2.5 py-1.5 rounded-sm">
          <button
            id="hero-prev-btn"
            type="button"
            class="text-white hover:text-zero-red p-1 transition-colors duration-200 cursor-pointer focus:outline-none"
            aria-label="Foto precedente"
          >
            <svg class="w-5 h-5 md:w-6 md:h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
            </svg>
          </button>

          <span class="w-[1px] h-4 bg-white/30"></span>

          <button
            id="hero-next-btn"
            type="button"
            class="text-white hover:text-zero-red p-1 transition-colors duration-200 cursor-pointer focus:outline-none"
            aria-label="Foto successiva"
          >
            <svg class="w-5 h-5 md:w-6 md:h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </button>
        </div>
      </div>
    )}
  </div>

  <!-- 2. ELEMENTI SOTTO LA FOTO: SCRITTA DESCRITTIVA E DUE BOTTONI CENTRATI -->
  <div class="w-full max-w-4xl mx-auto px-4 sm:px-8 mt-6 sm:mt-8 md:mt-10 text-center space-y-5 sm:space-y-6">
    
    <!-- Scritta descrittiva in nero puro -->
    <p class="text-lg sm:text-xl md:text-2xl lg:text-3xl font-display font-medium text-zero-black tracking-tight leading-snug">
      {headline}
    </p>

    <!-- Due Bottoni Centrati -->
    <div class="flex flex-col sm:flex-row items-center justify-center gap-3.5 pt-1">
      <a
        href={primaryButtonLink}
        class="w-full sm:w-auto inline-flex items-center justify-center px-8 py-3.5 bg-zero-black text-white font-mono text-xs font-bold uppercase tracking-widest hover:bg-zero-red transition-colors duration-200 shadow-sm text-center"
      >
        {primaryButtonText}
      </a>
      <a
        href={secondaryButtonLink}
        class="w-full sm:w-auto inline-flex items-center justify-center px-8 py-3.5 border border-zero-black text-zero-black font-mono text-xs font-bold uppercase tracking-widest hover:bg-zero-black hover:text-white transition-colors duration-200 text-center"
      >
        {secondaryButtonText}
      </a>
    </div>

  </div>
</section>

<script>
  import { gsap } from "gsap";

  function initHeroSlider() {
    const stack = document.getElementById('hero-slides-stack');
    const slideLayers = document.querySelectorAll<HTMLElement>('.hero-slide-layer');
    const introLogo = document.getElementById('hero-intro-logo');
    const controls = document.getElementById('hero-controls');
    const prevBtn = document.getElementById('hero-prev-btn');
    const nextBtn = document.getElementById('hero-next-btn');
    const totalSlides = slideLayers.length;

    if (!stack || totalSlides === 0) return;

    let currentSlide = 0;
    let isIntroActive = true;
    let autoplayTimer: number | null = null;
    const slideInterval = 5000;

    function showSlideInstant(index: number) {
      slideLayers.forEach((layer, idx) => {
        if (idx === index) {
          layer.style.opacity = '1';
          layer.style.zIndex = '10';
        } else {
          layer.style.opacity = '0';
          layer.style.zIndex = '0';
        }
      });
    }

    // Controllo se l'intro è già stata visualizzata nella sessione
    const hasSeenIntro = sessionStorage.getItem('verace_intro_seen') === 'true';

    if (hasSeenIntro) {
      isIntroActive = false;
      showSlideInstant(0);
      stack.style.filter = 'grayscale(0%) saturate(100%)';
      if (introLogo) introLogo.style.display = 'none';
      if (controls) {
        controls.classList.remove('opacity-0');
        controls.classList.add('opacity-100');
      }
      if (totalSlides > 1) {
        startAutoplay();
      }
    } else {
      sessionStorage.setItem('verace_intro_seen', 'true');

      function buildShutterSequence(count: number) {
        if (count <= 1) return [{ time: 0.00, slide: 0 }];

        const timePoints = [
          0.00, 0.12, 0.24, 0.36, 0.48, 0.62, 0.78, 0.96, 
          1.18, 1.44, 1.76, 2.14, 2.60, 3.16, 3.80
        ];

        const seq: { time: number; slide: number }[] = [];
        let slideCursor = 0;

        for (let i = 0; i < timePoints.length; i++) {
          if (i === timePoints.length - 1) {
            seq.push({ time: timePoints[i], slide: 0 });
          } else {
            seq.push({ time: timePoints[i], slide: slideCursor % count });
            slideCursor++;
          }
        }

        return seq;
      }

      const shutterSequence = buildShutterSequence(totalSlides);

      const introTl = gsap.timeline({
        onComplete: () => {
          isIntroActive = false;
          if (controls) {
            controls.classList.remove('opacity-0');
            controls.classList.add('opacity-100');
          }
          if (totalSlides > 1) {
            startAutoplay();
          }
        }
      });

      // Sequenza scatti
      shutterSequence.forEach(({ time, slide }) => {
        introTl.call(() => {
          showSlideInstant(slide);
        }, [], time);
      });

      // Passaggio B&W -> Colore
      introTl.to(stack, {
        filter: "grayscale(0%) saturate(100%)",
        duration: 3.5,
        ease: "power2.inOut"
      }, 0);

      // Logo intro
      if (introLogo) {
        introTl.to(introLogo, {
          opacity: 1,
          scale: 1,
          duration: 1.2,
          ease: "power2.out"
        }, 0.3);

        introTl.to(introLogo, {
          opacity: 0,
          scale: 0.94,
          duration: 0.8,
          ease: "power2.in",
          onComplete: () => {
            introLogo.style.display = 'none';
          }
        }, 2.2);
      }
    }

    function transitionToSlide(targetIndex: number) {
      if (isIntroActive || totalSlides <= 1) return;

      if (targetIndex < 0) targetIndex = totalSlides - 1;
      if (targetIndex >= totalSlides) targetIndex = 0;

      const prevIndex = currentSlide;
      currentSlide = targetIndex;

      slideLayers.forEach((layer, idx) => {
        if (idx === currentSlide) {
          layer.style.zIndex = '10';
          gsap.fromTo(layer, 
            { opacity: 0 }, 
            { opacity: 1, duration: 0.8, ease: "power2.inOut" }
          );
        } else if (idx === prevIndex) {
          layer.style.zIndex = '5';
          gsap.to(layer, { opacity: 0, duration: 0.8, ease: "power2.inOut" });
        } else {
          layer.style.zIndex = '0';
          layer.style.opacity = '0';
        }
      });
    }

    function interruptIntroIfActive() {
      if (isIntroActive) {
        isIntroActive = false;
        gsap.killTweensOf([stack, introLogo]);
        if (stack) stack.style.filter = "grayscale(0%) saturate(100%)";
        if (introLogo) introLogo.style.opacity = "0";
        if (controls) {
          controls.classList.remove('opacity-0');
          controls.classList.add('opacity-100');
        }
      }
    }

    function nextSlide() {
      interruptIntroIfActive();
      transitionToSlide(currentSlide + 1);
    }

    function prevSlide() {
      interruptIntroIfActive();
      transitionToSlide(currentSlide - 1);
    }

    function startAutoplay() {
      if (totalSlides <= 1) return;
      stopAutoplay();
      autoplayTimer = window.setInterval(nextSlide, slideInterval);
    }

    function stopAutoplay() {
      if (autoplayTimer) {
        clearInterval(autoplayTimer);
        autoplayTimer = null;
      }
    }

    if (nextBtn) {
      nextBtn.addEventListener('click', () => {
        nextSlide();
        startAutoplay();
      });
    }

    if (prevBtn) {
      prevBtn.addEventListener('click', () => {
        prevSlide();
        startAutoplay();
      });
    }

    // Navigazione da tastiera
    const handleKeyboardNav = (e: KeyboardEvent) => {
      const activeTag = document.activeElement?.tagName;
      if (activeTag === 'INPUT' || activeTag === 'TEXTAREA' || (document.activeElement as HTMLElement)?.isContentEditable) {
        return;
      }

      if (e.key === 'ArrowRight' || e.key === 'Right') {
        nextSlide();
        startAutoplay();
      } else if (e.key === 'ArrowLeft' || e.key === 'Left') {
        prevSlide();
        startAutoplay();
      }
    };

    window.addEventListener('keydown', handleKeyboardNav);

    // Pausa su hover
    const heroSection = document.getElementById('hero-section');
    if (heroSection) {
      heroSection.addEventListener('mouseenter', stopAutoplay);
      heroSection.addEventListener('mouseleave', () => {
        if (!isIntroActive && totalSlides > 1) startAutoplay();
      });
    }

    // Touch Swipe Mobile
    let touchStartX = 0;
    let touchEndX = 0;

    heroSection?.addEventListener('touchstart', (e) => {
      touchStartX = e.changedTouches[0].screenX;
      stopAutoplay();
    }, { passive: true });

    heroSection?.addEventListener('touchend', (e) => {
      touchEndX = e.changedTouches[0].screenX;
      const diff = touchStartX - touchEndX;
      if (Math.abs(diff) > 40) {
        if (diff > 0) nextSlide();
        else prevSlide();
      }
      if (!isIntroActive && totalSlides > 1) startAutoplay();
    }, { passive: true });
  }

  document.addEventListener('DOMContentLoaded', initHeroSlider);
  document.addEventListener('astro:page-load', initHeroSlider);
</script>

