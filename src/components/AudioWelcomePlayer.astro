---
// AudioWelcomePlayer.astro
// Componente audio persistente tra le pagine con slider verticale del volume sempre visibile e comandi iconici Play / Pause
const audioSrc = "/audio/Kid%20Cudi%20-%20Erase%20Me%20-%20Main.mp3";
---

<div
  id="audio-persistent-root"
  transition:persist="verace-audio-root"
  class="fixed z-40 select-none pointer-events-none"
  aria-label="Controllo audio di benvenuto"
>
  <!-- Elemento Audio HTML5 Persistente -->
  <audio
    id="welcome-audio"
    src={audioSrc}
    preload="auto"
    playsinline
  ></audio>

  <!-- Widget Controller Audio Dinamico -->
  <div
    id="audio-controller-wrapper"
    class="fixed transition-all duration-500 ease-out pointer-events-auto audio-pos-bottom"
  >
    <!-- Stato 1: Audio Attivo / Unmuted -> Box Laterale Fluttuante TRASPARENTE SENZA SFONDO E SENZA CORNICI -->
    <div
      id="audio-active-box"
      class="hidden flex-col items-center gap-2 p-2 w-[54px] select-none bg-transparent"
    >
      <!-- Intestazione Audio On & Equalizzatore ad Onde -->
      <div class="flex flex-col items-center gap-1 pb-1 w-full">
        <div class="flex items-end justify-center gap-[3px] h-3.5 w-full drop-shadow-[0_2px_4px_rgba(0,0,0,0.4)]" aria-hidden="true">
          <span class="w-[2.5px] bg-zero-red rounded-full animate-[soundWave_0.8s_ease-in-out_infinite_alternate]"></span>
          <span class="w-[2.5px] bg-zero-black rounded-full animate-[soundWave_1.1s_ease-in-out_infinite_alternate_0.2s]"></span>
          <span class="w-[2.5px] bg-zero-red rounded-full animate-[soundWave_0.9s_ease-in-out_infinite_alternate_0.4s]"></span>
        </div>
        <span class="font-mono text-[9px] font-bold uppercase tracking-wider text-zero-black drop-shadow-[0_1px_3px_rgba(255,255,255,0.9)]">
          AUDIO ON
        </span>
      </div>

      <!-- SLIDER VERTICALE SEMPRE VISIBILE (Volume +/- con Track e Knob) -->
      <div class="flex flex-col items-center gap-1.5 py-1 w-full">
        <span class="text-[11px] text-zero-black font-mono font-bold leading-none select-none drop-shadow-[0_1px_3px_rgba(255,255,255,0.9)]">+</span>
        
        <!-- Area Touch/Click Slider Verticale -->
        <div
          id="vol-slider-hitarea"
          class="relative w-7 h-24 flex items-center justify-center cursor-pointer touch-none"
          title="Trascina o clicca per regolare il volume"
          role="slider"
          aria-label="Regolazione volume"
          aria-valuemin="0"
          aria-valuemax="100"
          aria-valuenow="80"
        >
          <!-- Traccia di Fondo -->
          <div class="relative w-1.5 h-full bg-neutral-300 rounded-full overflow-hidden flex flex-col justify-end shadow-inner">
            <!-- Barra di Riempimento Rosso Accento -->
            <div id="vol-slider-fill" class="w-full bg-zero-red rounded-full shadow-[0_0_6px_rgba(181,61,51,0.5)] transition-all duration-75" style="height: 80%;"></div>
          </div>
          
          <!-- Manopola / Knob Circolare -->
          <div
            id="vol-slider-knob"
            class="absolute w-3.5 h-3.5 bg-zero-red rounded-full shadow-[0_2px_6px_rgba(0,0,0,0.35)] pointer-events-none transition-all duration-75"
            style="bottom: calc(80% - 7px);"
          ></div>
        </div>

        <span class="text-[11px] text-zero-black font-mono font-bold leading-none select-none drop-shadow-[0_1px_3px_rgba(255,255,255,0.9)]">-</span>
        <span id="vol-slider-label" class="font-mono text-[10px] font-bold text-zero-black select-none drop-shadow-[0_1px_3px_rgba(255,255,255,0.9)]">80%</span>
      </div>

      <!-- Pulsante PAUSA (⏸) sul fondo del box -->
      <button
        id="audio-mute-toggle-btn"
        type="button"
        class="w-full pt-1 flex items-center justify-center text-zero-red hover:text-zero-black transition-colors cursor-pointer focus:outline-none group/btn py-1"
        title="Metti in pausa l'audio"
        aria-label="Pausa audio"
      >
        <svg class="w-4 h-4 fill-current transition-transform group-hover/btn:scale-125 drop-shadow-[0_2px_4px_rgba(0,0,0,0.3)]" viewBox="0 0 24 24">
          <path d="M6 4h4v16H6V4zm8 0h4v16h-4V4z" />
        </svg>
      </button>
    </div>

    <!-- Stato 2: Audio Muto / In Pausa / Terminato -> Icona PLAY (▶) in basso a destra TRASPARENTE SENZA SFONDO -->
    <button
      id="audio-muted-btn"
      type="button"
      class="flex items-center justify-center w-10 h-10 bg-transparent transition-all duration-300 cursor-pointer group"
      title="Riproduci audio"
      aria-label="Riproduci audio"
    >
      <svg class="w-6 h-6 fill-current text-zero-red transition-transform group-hover:scale-125 ml-0 drop-shadow-[0_2px_6px_rgba(0,0,0,0.3)]" viewBox="0 0 24 24">
        <path d="M6 4.5v15l14.5-7.5L6 4.5z" />
      </svg>
    </button>
  </div>
</div>

<style>
  @keyframes soundWave {
    0% {
      height: 20%;
    }
    100% {
      height: 100%;
    }
  }

  /* Posizione Lato Schermo (Stato Attivo / Unmuted) */
  .audio-pos-side {
    right: 1.25rem;
    top: 50%;
    transform: translateY(-50%);
  }

  /* Posizione In Basso a Destra (Stato Muto / Terminato) */
  .audio-pos-bottom {
    right: 1.5rem;
    bottom: 1.5rem;
    transform: translateY(0);
  }
</style>

<script>
  // Stato Audio Globale Persistente
  interface VeraceAudioState {
    isMuted: boolean;
    isPlaying: boolean;
    hasEnded: boolean;
    hasUserInteracted: boolean;
    volume: number; // da 0.0 a 1.0
  }

  function getGlobalAudioState(): VeraceAudioState {
    if (!(window as any).__veraceAudioState) {
      const savedVolume = parseFloat(sessionStorage.getItem('verace_audio_volume') || '0.8');
      (window as any).__veraceAudioState = {
        isMuted: false,
        isPlaying: false,
        hasEnded: false,
        hasUserInteracted: false,
        volume: isNaN(savedVolume) ? 0.8 : savedVolume,
      };
    }
    return (window as any).__veraceAudioState;
  }

  function updateVolumeUI() {
    const state = getGlobalAudioState();
    const fill = document.getElementById('vol-slider-fill');
    const knob = document.getElementById('vol-slider-knob');
    const label = document.getElementById('vol-slider-label');
    const hitarea = document.getElementById('vol-slider-hitarea');

    const percent = Math.round(state.volume * 100);
    if (fill) fill.style.height = `${percent}%`;
    if (knob) knob.style.bottom = `calc(${percent}% - 8px)`;
    if (label) label.textContent = `${percent}%`;
    if (hitarea) hitarea.setAttribute('aria-valuenow', percent.toString());
  }

  function updateAudioUI() {
    const wrapper = document.getElementById('audio-controller-wrapper');
    const activeBox = document.getElementById('audio-active-box');
    const mutedBtn = document.getElementById('audio-muted-btn');
    const state = getGlobalAudioState();

    if (!wrapper || !activeBox || !mutedBtn) return;

    if (!state.isMuted && state.isPlaying && !state.hasEnded) {
      // STATO ATTIVO -> A LATO DELLO SCHERMO
      wrapper.classList.remove('audio-pos-bottom');
      wrapper.classList.add('audio-pos-side');

      activeBox.classList.remove('hidden');
      activeBox.classList.add('flex');
      mutedBtn.classList.add('hidden');
      mutedBtn.classList.remove('flex');
    } else {
      // STATO MUTO / IN PAUSA / TERMINATO -> IN BASSO A DESTRA CON TASTO PLAY (▶)
      wrapper.classList.remove('audio-pos-side');
      wrapper.classList.add('audio-pos-bottom');

      activeBox.classList.add('hidden');
      activeBox.classList.remove('flex');
      mutedBtn.classList.remove('hidden');
      mutedBtn.classList.add('flex');
    }

    updateVolumeUI();
  }

  function initPersistentAudio() {
    const audio = document.getElementById('welcome-audio') as HTMLAudioElement | null;
    const muteToggleBtn = document.getElementById('audio-mute-toggle-btn');
    const mutedBtn = document.getElementById('audio-muted-btn');
    const volHitarea = document.getElementById('vol-slider-hitarea');
    const state = getGlobalAudioState();

    if (!audio) return;

    // Applica volume iniziale persistente
    audio.volume = state.volume;

    const maxTrackDuration = 50; // Circa 50 secondi max
    const fadeOutSeconds = 2; // Fade out negli ultimi 2 secondi

    function setAudioVolume(vol: number) {
      if (!audio) return;
      const clamped = Math.max(0, Math.min(1, vol));
      state.volume = clamped;
      sessionStorage.setItem('verace_audio_volume', clamped.toString());
      audio.volume = clamped;
      updateVolumeUI();
    }

    async function playAudio(fromStart = false) {
      if (!audio) return;
      try {
        if (fromStart || state.hasEnded) {
          audio.currentTime = 0;
          state.hasEnded = false;
        }
        state.isMuted = false;
        if (state.volume === 0) {
          setAudioVolume(0.8);
        } else {
          setAudioVolume(state.volume);
        }
        await audio.play();
        state.isPlaying = true;
        updateAudioUI();
      } catch (err) {
        console.warn('Playback prevented by browser policy:', err);
      }
    }

    function pauseAudio() {
      if (!audio) return;
      state.isMuted = true;
      audio.pause();
      state.isPlaying = false;
      updateAudioUI();
    }

    function toggleFromBottom() {
      if (state.hasEnded) {
        playAudio(true);
      } else if (state.isMuted) {
        playAudio(false);
      } else {
        playAudio(true);
      }
    }

    // Listener Pausa / Play
    if (muteToggleBtn) {
      muteToggleBtn.onclick = (e) => {
        e.stopPropagation();
        pauseAudio();
      };
    }

    if (mutedBtn) {
      mutedBtn.onclick = (e) => {
        e.stopPropagation();
        toggleFromBottom();
      };
    }

    // GESTIONE SLIDER VERTICALE SEMPRE VISIBILE (Click e Drag continuo)
    if (volHitarea) {
      const handleVolumeChange = (e: MouseEvent | TouchEvent) => {
        const rect = volHitarea.getBoundingClientRect();
        const clientY = 'touches' in e ? e.touches[0].clientY : e.clientY;
        const offsetY = rect.bottom - clientY;
        const newVolume = Math.max(0, Math.min(1, offsetY / rect.height));
        setAudioVolume(newVolume);
      };

      volHitarea.onmousedown = (e) => {
        e.stopPropagation();
        e.preventDefault();
        handleVolumeChange(e);

        const onMouseMove = (moveEvent: MouseEvent) => {
          handleVolumeChange(moveEvent);
        };
        const onMouseUp = () => {
          window.removeEventListener('mousemove', onMouseMove);
          window.removeEventListener('mouseup', onMouseUp);
        };
        window.addEventListener('mousemove', onMouseMove);
        window.addEventListener('mouseup', onMouseUp);
      };

      volHitarea.ontouchstart = (e) => {
        e.stopPropagation();
        handleVolumeChange(e);

        const onTouchMove = (moveEvent: TouchEvent) => {
          handleVolumeChange(moveEvent);
        };
        const onTouchEnd = () => {
          window.removeEventListener('touchmove', onTouchMove);
          window.removeEventListener('touchend', onTouchEnd);
        };
        window.addEventListener('touchmove', onTouchMove, { passive: true });
        window.addEventListener('touchend', onTouchEnd);
      };
    }

    // Monitoraggio del tempo per Fade-Out e Stop finale a fine traccia
    if (!(audio as any).__listenersAttached) {
      (audio as any).__listenersAttached = true;

      audio.addEventListener('timeupdate', () => {
        if (!audio || state.isMuted || state.hasEnded) return;

        const duration = (audio.duration && !isNaN(audio.duration)) 
          ? Math.min(audio.duration, maxTrackDuration)
          : maxTrackDuration;

        const current = audio.currentTime;

        // Negli ultimi 2 secondi: Fade-out lineare proporzionale al volume impostato
        if (current >= (duration - fadeOutSeconds) && current < duration) {
          const remaining = duration - current;
          audio.volume = state.volume * (remaining / fadeOutSeconds);
        } else if (current >= duration) {
          // LA TRACCIA È FINITA: NON RIPARTE MA ENTRA NELLO STATO IN PAUSA CON SIMBOLO PLAY (▶)
          audio.pause();
          audio.currentTime = 0;
          state.isPlaying = false;
          state.isMuted = true;
          state.hasEnded = true;
          audio.volume = state.volume;
          updateAudioUI();
        } else {
          audio.volume = state.volume;
        }
      });

      audio.addEventListener('ended', () => {
        audio.currentTime = 0;
        state.isPlaying = false;
        state.isMuted = true;
        state.hasEnded = true;
        audio.volume = state.volume;
        updateAudioUI();
      });

      // Avvio al primo tocco o clic dell'utente sulla pagina
      const handleFirstGesture = () => {
        if (state.hasUserInteracted) return;
        state.hasUserInteracted = true;

        ['click', 'touchstart', 'keydown'].forEach(evt => {
          window.removeEventListener(evt, handleFirstGesture);
        });

        if (!state.isMuted && !state.hasEnded) {
          playAudio(false);
        }
      };

      ['click', 'touchstart', 'keydown'].forEach(evt => {
        window.addEventListener(evt, handleFirstGesture, { once: true, passive: true });
      });
    }

    // Aggiorna l'interfaccia corrente
    updateAudioUI();
  }

  // Supporto per primo caricamento e navigazioni ViewTransitions di Astro
  document.addEventListener('DOMContentLoaded', initPersistentAudio);
  document.addEventListener('astro:page-load', initPersistentAudio);
</script>
