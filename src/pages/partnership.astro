---
import BaseLayout from '../layouts/BaseLayout.astro';
import DownloadButton from '../components/DownloadButton.astro';

const siteOrigin = Astro.site ? Astro.site.origin : 'https://fondazioneverace.eu';

// Structured Data FAQPage & Service for Google Rich Snippets
const faqs = [
  {
    question: "Come collaborano le aziende con VERACE?",
    answer: "VERACE sviluppa partnership strategiche su misura con le imprese del territorio: dall'ideazione e co-finanziamento di interventi sullo spazio pubblico e programmi culturali, fino alla misurazione dell'impatto sociale per i bilanci di sostenibilità aziendali (ESG e CSR)."
  },
  {
    question: "Quali tipologie di progetti possono essere realizzati insieme?",
    answer: "Interventi di rigenerazione urbana a base culturale, valorizzazione del paesaggio e delle filiere tradizionali, laboratori educativi per le nuove generazioni ed eventi pubblici di aggregazione comunitaria a Reggio Emilia e provincia."
  },
  {
    question: "Quali vantaggi ottiene l'impresa partner in termini di ESG e CSR?",
    answer: "Le aziende possono misurare concretamente il valore generato sul territorio attraverso indicatori di impatto verificabili, migliorare il proprio rating ESG, valorizzare il proprio impegno civico e consolidare il legame con la comunità locale."
  },
  {
    question: "Chi cura la progettazione e la realizzazione operativa dell'intervento?",
    answer: "Il team di VERACE coordina tutte le fasi: analisi dei bisogni del territorio, progettazione esecutiva, gestione delle relazioni con enti e istituzioni locali, esecuzione sul campo e monitoraggio continuo dei risultati."
  },
  {
    question: "Come avviare una proposta di collaborazione o richiedere un incontro?",
    answer: "È sufficiente compilare lo sportello di co-progettazione su questa pagina o inviare una richiesta diretta a info@fondazioneverace.eu per concordare un tavolo di confronto preliminare."
  }
];

const partnershipSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "@id": `${siteOrigin}/partnership#service`,
      "name": "Partnership Imprese e Co-progettazione ad Alto Impatto Sociale",
      "serviceType": "Partnership Strategiche & Rigenerazione Urbana",
      "provider": {
        "@type": "NGO",
        "name": "VERACE",
        "url": siteOrigin
      },
      "areaServed": [
        { "@type": "AdministrativeArea", "name": "Reggio Emilia" },
        { "@type": "AdministrativeArea", "name": "Provincia di Reggio Emilia" },
        { "@type": "AdministrativeArea", "name": "Emilia-Romagna" }
      ],
      "description": "Modello di collaborazione tra imprese e terzo settore basato sull'analisi dei bisogni del territorio e la creazione di progetti ad alto impatto sociale."
    },
    {
      "@type": "FAQPage",
      "@id": `${siteOrigin}/partnership#faq`,
      "mainEntity": faqs.map(faq => ({
        "@type": "Question",
        "name": faq.question,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": faq.answer
        }
      }))
    }
  ]
};
---

<BaseLayout
  title="Partnership & Co-progettazione Imprese | VERACE"
  description="Modello di collaborazione tra imprese e terzo settore a Reggio Emilia: progetti ad alto impatto sociale, rigenerazione urbana e valorizzazione ESG."
  keywords="partnership imprese Reggio Emilia, co-progettazione terzo settore, CSR Reggio Emilia, rating ESG imprese, rigenerazione urbana, VERACE"
  customSchema={partnershipSchema}
>
  <div class="w-full bg-zero-bg">
    
    <!-- A) Apertura Sezione Partnership (Semplificata stile Magazine) -->
    <header class="px-4 sm:px-6 lg:px-8 py-12 md:py-16 bg-zero-paper gsap-fade-up">
      <div class="max-w-7xl mx-auto flex flex-col md:flex-row md:items-center justify-between gap-8">
        <div>
          <h1 class="hero-headline text-zero-black uppercase">
            PARTNERSHIP
          </h1>
        </div>
        <div class="max-w-lg space-y-4">
          <p class="text-sm md:text-base font-light text-zero-black leading-relaxed">
            Verace ha sviluppato un modello di collaborazione tra imprese e terzo settore, che si basa sull’analisi dei bisogni del territorio e la creazione di progetti ad alto impatto sociale con imprese, fondazioni e enti no-profit.
          </p>
          <div>
            <a
              href="#richiesta-partner"
              class="inline-flex items-center gap-3 px-6 py-3.5 bg-zero-red text-white ui-meta font-bold hover:bg-zero-black transition-colors duration-300 shadow-sm"
            >
              <span>RICHIEDI CO-PROGETTAZIONE</span>
              <span>→</span>
            </a>
          </div>
        </div>
      </div>
    </header>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 lg:py-24 space-y-24">
      
      <!-- C) Sezione "Come Collaborare con VERACE" e Schema a 4 Step (Senza cornici, sfondo neutro #FFFCF9) -->
      <section class="space-y-12 gsap-fade-up">
        <div class="max-w-4xl space-y-4">
          <h2 class="font-display font-black text-3xl md:text-5xl uppercase text-zero-black tracking-tight leading-tight">
            COME COLLABORARE CON VERACE
          </h2>
          <p class="text-lg md:text-xl text-zero-black font-light leading-relaxed">
            Verace collabora con le aziende del territorio che desiderano investire in progetti ad alto impatto sociale realizzando: interventi sullo spazio pubblico, programmi culturali, progetti di rigenerazione urbana a base culturale. Aiutando a migliorare rating ESG, CSR e contribuendo allo sviluppo sociale ed economico della comunità.
          </p>
        </div>

        <!-- 4 Step Numerati SENZA sottotesto descrittivo -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 pt-4">
          <div class="p-6 bg-zero-paper shadow-sm space-y-3">
            <span class="text-4xl font-display font-black text-zero-red block">1</span>
            <h3 class="font-display font-bold text-lg uppercase text-zero-black leading-snug">
              analizziamo i bisogni del territorio
            </h3>
          </div>

          <div class="p-6 bg-zero-paper shadow-sm space-y-3">
            <span class="text-4xl font-display font-black text-zero-red block">2</span>
            <h3 class="font-display font-bold text-lg uppercase text-zero-black leading-snug">
              costruiamo partnership virtuose
            </h3>
          </div>

          <div class="p-6 bg-zero-paper shadow-sm space-y-3">
            <span class="text-4xl font-display font-black text-zero-red block">3</span>
            <h3 class="font-display font-bold text-lg uppercase text-zero-black leading-snug">
              progettiamo l’intervento
            </h3>
          </div>

          <div class="p-6 bg-zero-paper shadow-sm space-y-3">
            <span class="text-4xl font-display font-black text-zero-red block">4</span>
            <h3 class="font-display font-bold text-lg uppercase text-zero-black leading-snug">
              misuriamo l’impatto con strumenti in linea con gli standard europei della sostenibilità
            </h3>
          </div>
        </div>

        <!-- D) Pulsante Scarica Dossier Progetti -->
        <div class="pt-6 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6 border-t border-neutral-200">
          <div class="font-mono text-xs text-neutral-600 uppercase">
            DISPONIBILE DOSSIER COMPLETO PER DIREZIONI SOSTENIBILITÀ, CSR ED ENTI DEL TERRITORIO
          </div>
          <DownloadButton
            href="/pdf/sample-project-presentation.pdf"
            label="SCARICA IL DOSSIER PROGETTI"
            fileSize="PDF 2.4 MB"
            variant="solid"
          />
        </div>
      </section>

      <!-- Casi Studio Territoriali -->
      <section class="space-y-12 gsap-fade-up">
        <div class="flex flex-col md:flex-row md:items-end justify-between pb-4 gap-4">
          <div>
            <div class="ui-meta text-zero-red font-bold mb-1">PROGETTI ATTIVI</div>
            <h2 class="font-display font-black text-3xl md:text-4xl uppercase text-zero-black tracking-tight">
              ESEMPI DI COLLABORAZIONE SUL TERRITORIO
            </h2>
          </div>
          <a href="/progetti" class="ui-meta text-zero-red font-bold hover:text-zero-black transition-colors">
            VEDI TUTTI I PROGETTI →
          </a>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          <!-- Progetto 1 -->
          <article class="bg-zero-paper shadow-sm hover:shadow-md transition-all duration-300 overflow-hidden group">
            <div class="aspect-[16/10] overflow-hidden bg-neutral-100">
              <img
                src="/projects/LA BELA/IMG_4931.webp"
                alt="Progetto LA BELA filiera lana Appennino Reggiano"
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              />
            </div>
            <div class="p-6 space-y-4">
              <div class="flex items-center justify-between font-mono text-xs">
                <span class="text-zero-red font-bold">APPENNINO REGGIANO</span>
                <span class="text-neutral-500">PARTNER: SALEWA / ALPINAFLORA</span>
              </div>
              <h3 class="font-display font-black text-xl uppercase text-zero-black group-hover:text-zero-red transition-colors">
                <a href="/progetti/progetto/la-bela">LA BELA: FILIERA DELLA LANA</a>
              </h3>
              <p class="text-xs text-neutral-600 font-light leading-relaxed line-clamp-3">
                Laboratorio itinerante in Appennino per 20 ragazzi per riscoprire la filiera della lana e supportare l'economia circolare montana.
              </p>
            </div>
          </article>

          <!-- Progetto 2 -->
          <article class="bg-zero-paper shadow-sm hover:shadow-md transition-all duration-300 overflow-hidden group">
            <div class="aspect-[16/10] overflow-hidden bg-neutral-100">
              <img
                src="/projects/SCUOLA DI TERRITORIO/ST_2026-22.webp"
                alt="Scuola di Territorio Reggio Emilia con Fondazione Manodori"
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              />
            </div>
            <div class="p-6 space-y-4">
              <div class="flex items-center justify-between font-mono text-xs">
                <span class="text-zero-red font-bold">REGGIO EMILIA CITTÀ</span>
                <span class="text-neutral-500">FONDAZIONE MANODORI / ASINERIA</span>
              </div>
              <h3 class="font-display font-black text-xl uppercase text-zero-black group-hover:text-zero-red transition-colors">
                <a href="/progetti/progetto/scuola-di-territorio">SCUOLA DI TERRITORIO</a>
              </h3>
              <p class="text-xs text-neutral-600 font-light leading-relaxed line-clamp-3">
                Percorso biennale per ragazzi 11-14 anni tra città e natura, cammini fluviali e micro-avventure urbane a Reggio Emilia.
              </p>
            </div>
          </article>

          <!-- Progetto 3 -->
          <article class="bg-zero-paper shadow-sm hover:shadow-md transition-all duration-300 overflow-hidden group">
            <div class="aspect-[16/10] overflow-hidden bg-neutral-100">
              <img
                src="/projects/VIAGGI DOMENICALI MINIMI/2_POST_DEFINITIVI_VIAGGIDOMENICALI-14.webp"
                alt="Viaggi Domenicali Minimi Luigi Ghirri Reggio Emilia"
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              />
            </div>
            <div class="p-6 space-y-4">
              <div class="flex items-center justify-between font-mono text-xs">
                <span class="text-zero-red font-bold">VALLE DEL CROSTOLO & BASSA</span>
                <span class="text-neutral-500">FONDAZIONE LUIGI GHIRRI</span>
              </div>
              <h3 class="font-display font-black text-xl uppercase text-zero-black group-hover:text-zero-red transition-colors">
                <a href="/progetti/progetto/viaggi-domenicali-minimi">VIAGGI DOMENICALI MINIMI</a>
              </h3>
              <p class="text-xs text-neutral-600 font-light leading-relaxed line-clamp-3">
                10 viaggi minimi in bicicletta per valorizzare il paesaggio emiliano e riscoprire l'immaginario visivo di Luigi Ghirri.
              </p>
            </div>
          </article>
        </div>
      </section>

      <!-- D) Sportello di Co-progettazione Imprese (Sfondo neutro / senza cornici bianche) -->
      <section id="richiesta-partner" class="bg-zero-paper p-8 md:p-14 space-y-8 shadow-sm scroll-mt-28 gsap-fade-up">
        <div class="max-w-2xl">
          <div class="ui-meta text-zero-red font-bold mb-2">SPORTELLO DI CO-PROGETTAZIONE</div>
          <h2 class="font-display font-black text-3xl md:text-4xl uppercase text-zero-black tracking-tight">
            RICHIEDI UN TAVOLO DI CO-PROGETTAZIONE
          </h2>
          <p class="text-sm text-neutral-700 mt-2 font-light">
            Sei un'azienda, una fondazione o un ente del Terzo Settore? Raccontaci la tua idea o richiedi una consulenza preliminare per costruire insieme un progetto sul territorio.
          </p>
        </div>

        <form
          class="grid grid-cols-1 md:grid-cols-2 gap-6"
          onsubmit="event.preventDefault(); alert('Grazie per la richiesta. Il team di VERACE ti ricontatterà entro 24 ore lavorative.');"
        >
          <div class="space-y-2">
            <label class="block font-mono text-xs uppercase font-bold text-zero-black">Azienda / Ente *</label>
            <input
              type="text"
              required
              placeholder="ES. AZIENDA O ENTE SOSTENITORE"
              class="w-full px-4 py-3 bg-zero-bg focus:bg-white text-sm font-mono focus:outline-none focus:ring-1 focus:ring-zero-red transition-all shadow-sm"
            />
          </div>

          <div class="space-y-2">
            <label class="block font-mono text-xs uppercase font-bold text-zero-black">Nome e Cognome Referente *</label>
            <input
              type="text"
              required
              placeholder="ES. MARCO BIANCHI"
              class="w-full px-4 py-3 bg-zero-bg focus:bg-white text-sm font-mono focus:outline-none focus:ring-1 focus:ring-zero-red transition-all shadow-sm"
            />
          </div>

          <div class="space-y-2">
            <label class="block font-mono text-xs uppercase font-bold text-zero-black">Email Istituzionale *</label>
            <input
              type="email"
              required
              placeholder="REFERENTE@AZIENDA.IT"
              class="w-full px-4 py-3 bg-zero-bg focus:bg-white text-sm font-mono focus:outline-none focus:ring-1 focus:ring-zero-red transition-all shadow-sm"
            />
          </div>

          <div class="space-y-2">
            <label class="block font-mono text-xs uppercase font-bold text-zero-black">Ambito di Interesse</label>
            <select class="w-full px-4 py-3 bg-zero-bg focus:bg-white text-sm font-mono focus:outline-none focus:ring-1 focus:ring-zero-red transition-all shadow-sm">
              <option value="RIGENERAZIONE">Interventi sullo Spazio Pubblico & Rigenerazione Urbana</option>
              <option value="CULTURA">Programmi Culturali & Editoriali</option>
              <option value="GIOVANI">Progetti Educativi & Comunità</option>
              <option value="ESG">Partnership CSR & Rendicontazione ESG</option>
              <option value="ALTRO">Altro / Proposta Personalizzata</option>
            </select>
          </div>

          <div class="md:col-span-2 space-y-2">
            <label class="block font-mono text-xs uppercase font-bold text-zero-black">Descrizione Sintetica dell'Iniziativa o Necessità</label>
            <textarea
              rows="4"
              placeholder="Indica gli obiettivi aziendali, il budget stimato o l'area territoriale di interesse..."
              class="w-full px-4 py-3 bg-zero-bg focus:bg-white text-sm font-mono focus:outline-none focus:ring-1 focus:ring-zero-red transition-all shadow-sm"
            ></textarea>
          </div>

          <div class="md:col-span-2 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 pt-4 border-t border-neutral-200">
            <div class="font-mono text-xs text-neutral-500">
              * I dati saranno trattati nel rispetto della Privacy Policy e utilizzati esclusivamente per ricontattarti.
            </div>
            <button
              type="submit"
              class="px-8 py-4 bg-zero-red text-white ui-meta font-bold hover:bg-zero-black transition-colors duration-300 w-full sm:w-auto shadow-sm cursor-pointer"
            >
              INVIA RICHIESTA CO-PROGETTAZIONE →
            </button>
          </div>
        </form>
      </section>

      <!-- D) Domande Frequenti / FAQ (Font Lineare e Pulito, senza font display Populista) -->
      <section class="space-y-8 gsap-fade-up">
        <div class="pb-2">
          <div class="ui-meta text-zero-red font-bold mb-2">FAQ PARTNERSHIP</div>
          <h2 class="font-sans font-bold text-2xl md:text-3xl text-zero-black tracking-tight">
            Domande Frequenti sulla Co-progettazione
          </h2>
        </div>

        <div class="space-y-4">
          {faqs.map((faq) => (
            <details class="group bg-zero-paper p-6 shadow-sm transition-all duration-300">
              <summary class="flex items-center justify-between font-sans font-bold text-base md:text-lg text-zero-black cursor-pointer select-none">
                <span>{faq.question}</span>
                <span class="font-mono text-zero-red text-xl transition-transform duration-300 group-open:rotate-45">+</span>
              </summary>
              <div class="pt-4 text-neutral-700 font-sans font-light text-sm md:text-base leading-relaxed border-t border-neutral-200/60 mt-4">
                {faq.answer}
              </div>
            </details>
          ))}
        </div>
      </section>

    </div>
  </div>
</BaseLayout>
