---
import BaseLayout from '../layouts/BaseLayout.astro';
import DownloadButton from '../components/DownloadButton.astro';

const siteOrigin = Astro.site ? Astro.site.origin : 'https://fondazioneverace.eu';

// Structured Data FAQPage & Service for Google Rich Snippets
const faqs = [
  {
    question: "Come possono le aziende di Reggio Emilia accedere ai Fondi Europei tramite Fondazione VERACE?",
    answer: "Fondazione VERACE opera come partner del Terzo Settore abilitato alla co-progettazione e alla partecipazione a bandi europei (FESR, FSE+, PNRR, Horizon). Le aziende possono collaborare sia come co-finanziatori con sgravi fiscali e valorizzazione ESG, sia come partner tecnici e industriali nei consorzi di progetto sul territorio di Reggio Emilia ed Emilia-Romagna."
  },
  {
    question: "Quali programmi di finanziamento europeo sono attivi su Reggio Emilia e provincia?",
    answer: "I principali strumenti attivi includono il FESR Emilia-Romagna (innovazione, sostenibilità ed efficientamento), il FSE+ (competenze, occupabilità e inclusione sociale), le missioni del PNRR dedicate alla rigenerazione urbana e alle comunità energetiche (CER), oltre ai bandi territoriali congiunti con Fondazione Manodori e la Regione Emilia-Romagna."
  },
  {
    question: "Qual è il vantaggio per una società nel co-progettare iniziative con il Terzo Settore?",
    answer: "La co-progettazione consente alle imprese di intercettare fondi altrimenti riservati ad enti non-profit, generare un impatto sociale tangibile e misurabile sul territorio emiliano, e integrare tali risultati nei propri report di sostenibilità e bilanci di sostenibilità ESG."
  },
  {
    question: "Chi si occupa della rendicontazione e della conformità dei bandi europei?",
    answer: "Il team di europrogettisti e revisori di Fondazione VERACE gestisce l'intero ciclo di vita del progetto: dalla candidatura formale, al monitoraggio delle milestone, fino alla rendicontazione economica e qualitativa conforme ai regolamenti dell'Unione Europea."
  },
  {
    question: "Come richiedere uno studio di fattibilità per un'opportunità di finanziamento a Reggio Emilia?",
    answer: "È possibile compilare il modulo di contatto su questa pagina o inviare una richiesta direttamente a info@fondazioneverace.eu specificando l'ambito di attività dell'azienda e gli obiettivi di impatto territoriale."
  }
];

const fondiSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "@id": `${siteOrigin}/fondi-europei#service`,
      "name": "Intercettazione, Advisory e Co-progettazione Fondi Europei Reggio Emilia",
      "serviceType": "Consulenza e Co-progettazione Fondi Europei (FSE+, FESR, PNRR)",
      "provider": {
        "@type": "NGO",
        "name": "Fondazione VERACE",
        "url": siteOrigin
      },
      "areaServed": [
        { "@type": "AdministrativeArea", "name": "Reggio Emilia" },
        { "@type": "AdministrativeArea", "name": "Provincia di Reggio Emilia" },
        { "@type": "AdministrativeArea", "name": "Emilia-Romagna" },
        { "@type": "AdministrativeArea", "name": "Appennino Reggiano" }
      ],
      "description": "Sportello di europrogettazione, monitoraggio bandi e attivazione di partenariati pubblico-privati su Reggio Emilia e territorio emiliano per bandi FESR, FSE+, PNRR ed ESG.",
      "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "name": "Linee di Co-progettazione Europea",
        "itemListElement": [
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Rigenerazione Urbana & PNRR"
            }
          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Transizione Ecologica & FESR Emilia-Romagna"
            }
          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Inclusione Sociale & FSE+"
            }
          }
        ]
      }
    },
    {
      "@type": "FAQPage",
      "@id": `${siteOrigin}/fondi-europei#faq`,
      "mainEntity": faqs.map(faq => ({
        "@type": "Question",
        "name": faq.question,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": faq.answer
        }
      }))
    }
  ]
};
---

<BaseLayout
  title="Fondi Europei Reggio Emilia & Opportunità Imprese | Fondazione VERACE"
  description="Hub strategico per Fondi Europei (FSE+, FESR, PNRR) a Reggio Emilia e provincia. Supporto a imprese, PMI ed enti per intercettare finanziamenti e co-progettare attività sul territorio."
  keywords="fondi europei Reggio Emilia, bandi FSE+ FESR Emilia Romagna, PNRR Reggio Emilia, consulenza bandi imprese, co-progettazione terzo settore, finanziamenti territorio emiliano, Fondazione VERACE"
  customSchema={fondiSchema}
>
  <div class="w-full bg-zero-bg">
    
    <!-- Hero Header -->
    <header class="px-4 sm:px-6 lg:px-8 py-16 lg:py-24 bg-zero-paper gsap-fade-up">
      <div class="max-w-7xl mx-auto flex flex-col lg:flex-row lg:items-end justify-between gap-8">
        <div class="max-w-3xl">
          <div class="ui-meta text-zero-red font-bold mb-4 flex items-center gap-2">
            <span>EUROPROGETTAZIONE & IMPATTO TERRITORIALE</span>
            <span class="inline-block w-2 h-2 bg-zero-red rounded-full"></span>
            <span class="text-neutral-500">REGGIO EMILIA & EMILIA-ROMAGNA</span>
          </div>
          <h1 class="hero-headline text-zero-black uppercase leading-[0.85]">
            FONDI EUROPEI<br/>& PARTNERSHIP<br/>PER LE IMPRESE
          </h1>
        </div>
        <div class="max-w-md space-y-4">
          <p class="text-lg font-light text-zero-black leading-relaxed">
            Fondazione VERACE è l'interlocutore di riferimento per aziende, enti locali e Terzo Settore intenzionati a <span class="font-bold">intercettare, gestire e mettere a terra i fondi europei e regionali</span> sul territorio di Reggio Emilia e provincia.
          </p>
          <div class="pt-2">
            <a
              href="#richiesta-partner"
              class="inline-flex items-center gap-3 px-6 py-3.5 bg-zero-red text-white ui-meta font-bold hover:bg-zero-black transition-colors duration-300 shadow-sm"
            >
              <span>RICHIEDI CO-PROGETTAZIONE</span>
              <span>→</span>
            </a>
          </div>
        </div>
      </div>
    </header>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 lg:py-24 space-y-24">
      
      <!-- Sezione 4 Aree di Finanziamento -->
      <section class="space-y-12 gsap-fade-up">
        <div class="flex flex-col md:flex-row md:items-end justify-between pb-6 gap-4">
          <div>
            <div class="ui-meta text-zero-red font-bold mb-2">01 / PROGRAMMI & STRUMENTI</div>
            <h2 class="font-display font-black text-3xl md:text-4xl uppercase text-zero-black tracking-tight">
              LE LINEE DI FINANZIAMENTO INTERCETTATE
            </h2>
          </div>
          <p class="text-sm font-mono text-neutral-600 max-w-sm">
            Monitoraggio costante delle opportunità europee, nazionali e regionali per il territorio reggiano.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
          <!-- Card 1 -->
          <div class="bg-zero-paper p-8 space-y-6 flex flex-col justify-between shadow-sm hover:shadow-md transition-all duration-300">
            <div class="space-y-4">
              <div class="font-mono text-xs text-zero-red font-bold uppercase tracking-wider">01. PNRR</div>
              <h3 class="font-display font-black text-2xl uppercase text-zero-black leading-tight">
                RIGENERAZIONE URBANA & SPAZI EX INDUSTRIALI
              </h3>
              <p class="text-sm text-neutral-700 font-light leading-relaxed">
                Riqualificazione di manufatti storici, ex officine (es. Area Reggiane e poli periferici), creazione di hub socio-culturali e nuovi spazi civici condivisi.
              </p>
            </div>
            <div class="pt-4 border-t border-neutral-100 font-mono text-xs text-neutral-500">
              Target: Missione 5 & 13 PNRR
            </div>
          </div>

          <!-- Card 2 -->
          <div class="bg-zero-paper p-8 space-y-6 flex flex-col justify-between shadow-sm hover:shadow-md transition-all duration-300">
            <div class="space-y-4">
              <div class="font-mono text-xs text-zero-red font-bold uppercase tracking-wider">02. FESR EMILIA-ROMAGNA</div>
              <h3 class="font-display font-black text-2xl uppercase text-zero-black leading-tight">
                TRANSIZIONE ECOLOGICA & INNOVAZIONE
              </h3>
              <p class="text-sm text-neutral-700 font-light leading-relaxed">
                Progetti di decarbonizzazione, Comunità Energetiche Rinnovabili (CER), riforestazione urbana e digitalizzazione del patrimonio materiale e immateriale.
              </p>
            </div>
            <div class="pt-4 border-t border-neutral-100 font-mono text-xs text-neutral-500">
              Target: PR-FESR 2021-2027
            </div>
          </div>

          <!-- Card 3 -->
          <div class="bg-zero-paper p-8 space-y-6 flex flex-col justify-between shadow-sm hover:shadow-md transition-all duration-300">
            <div class="space-y-4">
              <div class="font-mono text-xs text-zero-red font-bold uppercase tracking-wider">03. FSE+ & ERASMUS+</div>
              <h3 class="font-display font-black text-2xl uppercase text-zero-black leading-tight">
                COMPETENZE, GIOVANI & INCLUSIONE
              </h3>
              <p class="text-sm text-neutral-700 font-light leading-relaxed">
                Percorsi formativi all'aperto, laboratori creativi, reinserimento lavorativo in filiere tradizionali (lana, artigianato, agricoltura sociale) ed educazione civica.
              </p>
            </div>
            <div class="pt-4 border-t border-neutral-100 font-mono text-xs text-neutral-500">
              Target: PR-FSE+ & Fondo Sociale Europeo
            </div>
          </div>

          <!-- Card 4 -->
          <div class="bg-zero-paper p-8 space-y-6 flex flex-col justify-between shadow-sm hover:shadow-md transition-all duration-300">
            <div class="space-y-4">
              <div class="font-mono text-xs text-zero-red font-bold uppercase tracking-wider">04. BANDI TERRITORIALI</div>
              <h3 class="font-display font-black text-2xl uppercase text-zero-black leading-tight">
                FONDAZIONI BANCARIE & RETI LOCALI
              </h3>
              <p class="text-sm text-neutral-700 font-light leading-relaxed">
                Iniziative congiunte con Fondazione Manodori, istituzioni comunali e provinciali, parchi e consorzi per la coesione delle comunità della Bassa e dell'Appennino.
              </p>
            </div>
            <div class="pt-4 border-t border-neutral-100 font-mono text-xs text-neutral-500">
              Target: Bandi Welfare & Territorio
            </div>
          </div>
        </div>
      </section>

      <!-- Modello B2B per le Imprese -->
      <section class="bg-zero-paper p-8 md:p-14 space-y-12 shadow-sm gsap-fade-up">
        <div class="max-w-3xl space-y-4">
          <div class="ui-meta text-zero-red font-bold">MODELLO DI PARTNERSHIP B2B</div>
          <h2 class="font-display font-black text-3xl md:text-5xl uppercase text-zero-black tracking-tight leading-tight">
            PERCHÉ E COME LE SOCIETÀ COLLABORANO CON VERACE
          </h2>
          <p class="text-lg text-neutral-800 font-light leading-relaxed">
            Spesso le aziende hanno l'interesse strategico o l'obbligo di investire in sostenibilità, ma mancano del veicolo operativo o del radicamento civico per partecipare ai bandi europei ad impatto sociale. VERACE colma questo divario.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 pt-4">
          <div class="space-y-3 font-mono">
            <div class="text-zero-red font-bold text-lg">01 /</div>
            <h3 class="font-bold text-sm uppercase text-zero-black">ANALISI & RADICAMENTO</h3>
            <p class="text-xs text-neutral-600 font-sans leading-relaxed">
              Mappiamo i bisogni reali del territorio reggiano (urbano e montano) per presentare progetti credibili e non calati dall'alto.
            </p>
          </div>

          <div class="space-y-3 font-mono">
            <div class="text-zero-red font-bold text-lg">02 /</div>
            <h3 class="font-bold text-sm uppercase text-zero-black">EURO-PROGETTAZIONE</h3>
            <p class="text-xs text-neutral-600 font-sans leading-relaxed">
              Strutturiamo candidature competitive per bandi PNRR, FESR, FSE+ ed enti filantropici con standard di rendicontazione europei.
            </p>
          </div>

          <div class="space-y-3 font-mono">
            <div class="text-zero-red font-bold text-lg">03 /</div>
            <h3 class="font-bold text-sm uppercase text-zero-black">ATTUAZIONE SUL CAMPO</h3>
            <p class="text-xs text-neutral-600 font-sans leading-relaxed">
              Gestiamo operativamente cantieri culturali, workshop giovanili, eventi pubblici e campagne visive di documentazione.
            </p>
          </div>

          <div class="space-y-3 font-mono">
            <div class="text-zero-red font-bold text-lg">04 /</div>
            <h3 class="font-bold text-sm uppercase text-zero-black">IMPATTO & RATING ESG</h3>
            <p class="text-xs text-neutral-600 font-sans leading-relaxed">
              Forniamo alle aziende partner indicatori quantitativi e qualitativi per i propri report di sostenibilità e bilanci sociali.
            </p>
          </div>
        </div>
      </section>

      <!-- Casi Studio Territoriali -->
      <section class="space-y-12 gsap-fade-up">
        <div class="flex flex-col md:flex-row md:items-end justify-between pb-4 gap-4">
          <div>
            <div class="ui-meta text-zero-red font-bold mb-1">PROGETTI ATTIVI</div>
            <h2 class="font-display font-black text-3xl md:text-4xl uppercase text-zero-black tracking-tight">
              ESEMPI DI CO-PROGETTAZIONE SUL TERRITORIO
            </h2>
          </div>
          <a href="/progetti" class="ui-meta text-zero-red font-bold hover:text-zero-black transition-colors">
            VEDI TUTTI I PROGETTI →
          </a>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-12">
          <!-- Progetto 1 -->
          <article class="bg-zero-paper shadow-sm hover:shadow-md transition-all duration-300 overflow-hidden group">
            <div class="aspect-[4/3] sm:aspect-[16/10] overflow-hidden bg-neutral-100">
              <img
                src="/projects/LA BELA/IMG_4931.webp"
                alt="Progetto LA BELA filiera lana Appennino Reggiano"
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              />
            </div>
            <div class="p-6 sm:p-8 space-y-4">
              <div class="flex items-center justify-between font-mono text-xs">
                <span class="text-zero-red font-bold">APPENNINO REGGIANO</span>
                <span class="text-neutral-500">PARTNER: SALEWA / ALPINAFLORA</span>
              </div>
              <h3 class="font-display font-black text-xl sm:text-2xl uppercase text-zero-black">
                LA BELA: FILIERA DELLA LANA
              </h3>
              <p class="text-sm text-neutral-600 font-light leading-relaxed">
                Laboratorio itinerante in Appennino per 20 ragazzi per riscoprire la filiera della lana e supportare l'economia circolare montana.
              </p>
              <a href="/progetti/progetto/la-bela" class="inline-block text-xs font-mono font-bold text-zero-red hover:underline">
                LEGGI SCHEDA PROGETTO →
              </a>
            </div>
          </article>

          <!-- Progetto 2 -->
          <article class="bg-zero-paper shadow-sm hover:shadow-md transition-all duration-300 overflow-hidden group">
            <div class="aspect-[4/3] sm:aspect-[16/10] overflow-hidden bg-neutral-100">
              <img
                src="/projects/SCUOLA DI TERRITORIO/ST_2026-22.webp"
                alt="Scuola di Territorio Reggio Emilia con Fondazione Manodori"
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              />
            </div>
            <div class="p-6 sm:p-8 space-y-4">
              <div class="flex items-center justify-between font-mono text-xs">
                <span class="text-zero-red font-bold">REGGIO EMILIA CITTÀ</span>
                <span class="text-neutral-500">FONDAZIONE MANODORI / ASINERIA</span>
              </div>
              <h3 class="font-display font-black text-xl sm:text-2xl uppercase text-zero-black">
                SCUOLA DI TERRITORIO
              </h3>
              <p class="text-sm text-neutral-600 font-light leading-relaxed">
                Percorso biennale per ragazzi 11-14 anni tra città e natura, cammini fluviali e micro-avventure urbane a Reggio Emilia.
              </p>
              <a href="/progetti/progetto/scuola-di-territorio" class="inline-block text-xs font-mono font-bold text-zero-red hover:underline">
                LEGGI SCHEDA PROGETTO →
              </a>
            </div>
          </article>

          <!-- Progetto 3 -->
          <article class="bg-zero-paper shadow-sm hover:shadow-md transition-all duration-300 overflow-hidden group">
            <div class="aspect-[4/3] sm:aspect-[16/10] overflow-hidden bg-neutral-100">
              <img
                src="/projects/VIAGGI DOMENICALI MINIMI/2_POST_DEFINITIVI_VIAGGIDOMENICALI-14.webp"
                alt="Viaggi Domenicali Minimi Luigi Ghirri Reggio Emilia"
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              />
            </div>
            <div class="p-6 sm:p-8 space-y-4">
              <div class="flex items-center justify-between font-mono text-xs">
                <span class="text-zero-red font-bold">VALLE DEL CROSTOLO & BASSA</span>
                <span class="text-neutral-500">FONDAZIONE LUIGI GHIRRI</span>
              </div>
              <h3 class="font-display font-black text-xl sm:text-2xl uppercase text-zero-black">
                VIAGGI DOMENICALI MINIMI
              </h3>
              <p class="text-sm text-neutral-600 font-light leading-relaxed">
                10 viaggi minimi in bicicletta per valorizzare il paesaggio emiliano e riscoprire l'immaginario visivo di Luigi Ghirri.
              </p>
              <a href="/progetti/progetto/viaggi-domenicali-minimi" class="inline-block text-xs font-mono font-bold text-zero-red hover:underline">
                LEGGI SCHEDA PROGETTO →
              </a>
            </div>
          </article>

          <!-- Progetto 4 -->
          <article class="bg-zero-paper shadow-sm hover:shadow-md transition-all duration-300 overflow-hidden group">
            <div class="aspect-[4/3] sm:aspect-[16/10] overflow-hidden bg-neutral-100">
              <img
                src="https://images.unsplash.com/photo-1581091226825-a6a2a5aee158?auto=format&fit=crop&w=800&q=80"
                alt="Cantiere Umano Maker Space Reggio Emilia"
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              />
            </div>
            <div class="p-6 sm:p-8 space-y-4">
              <div class="flex items-center justify-between font-mono text-xs">
                <span class="text-zero-red font-bold">REGGIO EMILIA NORD</span>
                <span class="text-neutral-500">TECHCORP / REGIONE LAZIO</span>
              </div>
              <h3 class="font-display font-black text-xl sm:text-2xl uppercase text-zero-black">
                CANTIERE UMANO: HUB DI INCLUSIONE
              </h3>
              <p class="text-sm text-neutral-600 font-light leading-relaxed">
                Polo tecnologico e artigianale integrato: laboratori di fabbricazione digitale, restauro e formazione giovanile.
              </p>
              <a href="/progetti/progetto/cantiere-umano" class="inline-block text-xs font-mono font-bold text-zero-red hover:underline">
                LEGGI SCHEDA PROGETTO →
              </a>
            </div>
          </article>
        </div>
      </section>

      <!-- Form di Contatto / Co-progettazione Imprese Frameless -->
      <section id="richiesta-partner" class="bg-zero-paper p-8 md:p-14 space-y-8 shadow-sm scroll-mt-28 gsap-fade-up">
        <div class="max-w-2xl">
          <div class="ui-meta text-zero-red font-bold mb-2">SPORTELLO IMPRESE & BANDI</div>
          <h2 class="font-display font-black text-3xl md:text-4xl uppercase text-zero-black tracking-tight">
            RICHIEDI UN TAVOLO DI CO-PROGETTAZIONE
          </h2>
          <p class="text-sm text-neutral-700 mt-2 font-light">
            Sei un'azienda, una PMI o un ente del Terzo Settore? Raccontaci la tua idea o richiedi una consulenza preliminare per intercettare i bandi attivi a Reggio Emilia.
          </p>
        </div>

        <form
          class="grid grid-cols-1 md:grid-cols-2 gap-6"
          onsubmit="event.preventDefault(); alert('Grazie per la richiesta. Il team di europrogettazione di VERACE ti ricontatterà entro 24 ore lavorative.');"
        >
          <div class="space-y-2">
            <label class="block font-mono text-xs uppercase font-bold text-zero-black">Azienda / Ente *</label>
            <input
              type="text"
              required
              placeholder="ES. COOPERATIVA REGGIO FUTURA SPA"
              class="w-full px-4 py-3 bg-zero-bg/80 focus:bg-white text-sm font-mono focus:outline-none focus:ring-1 focus:ring-zero-red transition-all"
            />
          </div>

          <div class="space-y-2">
            <label class="block font-mono text-xs uppercase font-bold text-zero-black">Nome e Cognome Referente *</label>
            <input
              type="text"
              required
              placeholder="ES. MARCO BIANCHI"
              class="w-full px-4 py-3 bg-zero-bg/80 focus:bg-white text-sm font-mono focus:outline-none focus:ring-1 focus:ring-zero-red transition-all"
            />
          </div>

          <div class="space-y-2">
            <label class="block font-mono text-xs uppercase font-bold text-zero-black">Email Istituzionale *</label>
            <input
              type="email"
              required
              placeholder="REFERENTE@AZIENDA.IT"
              class="w-full px-4 py-3 bg-zero-bg/80 focus:bg-white text-sm font-mono focus:outline-none focus:ring-1 focus:ring-zero-red transition-all"
            />
          </div>

          <div class="space-y-2">
            <label class="block font-mono text-xs uppercase font-bold text-zero-black">Ambito di Interesse</label>
            <select class="w-full px-4 py-3 bg-zero-bg/80 focus:bg-white text-sm font-mono focus:outline-none focus:ring-1 focus:ring-zero-red transition-all">
              <option value="PNRR">PNRR & Rigenerazione Territoriale</option>
              <option value="FESR">FESR Emilia-Romagna (Green & Tech)</option>
              <option value="FSE">FSE+ (Formazione, Giovani, Inclusione)</option>
              <option value="ESG">Partnership CSR & Rendicontazione ESG</option>
              <option value="ALTRO">Altro / Analisi Bandi Generica</option>
            </select>
          </div>

          <div class="md:col-span-2 space-y-2">
            <label class="block font-mono text-xs uppercase font-bold text-zero-black">Descrizione Sintetica dell'Iniziativa o Necessità</label>
            <textarea
              rows="4"
              placeholder="Indica gli obiettivi aziendali, il budget stimato o l'area territoriale di Reggio Emilia su cui intendi intervenire..."
              class="w-full px-4 py-3 bg-zero-bg/80 focus:bg-white text-sm font-mono focus:outline-none focus:ring-1 focus:ring-zero-red transition-all"
            ></textarea>
          </div>

          <div class="md:col-span-2 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 pt-4 border-t border-neutral-100">
            <div class="font-mono text-xs text-neutral-500">
              * I tuoi dati saranno trattati nel rispetto della Privacy Policy e utilizzati esclusivamente per la richiesta di contatto.
            </div>
            <button
              type="submit"
              class="px-8 py-4 bg-zero-red text-white ui-meta font-bold hover:bg-zero-black transition-colors duration-300 w-full sm:w-auto shadow-sm"
            >
              INVIA RICHIESTA CO-PROGETTAZIONE →
            </button>
          </div>
        </form>
      </section>

      <!-- Domande Frequenti / FAQ Frameless per Google Rich Snippets -->
      <section class="space-y-8 gsap-fade-up">
        <div class="pb-4">
          <div class="ui-meta text-zero-red font-bold mb-2">FAQ PER LE IMPRESE & GLI ENTI</div>
          <h2 class="font-display font-black text-2xl md:text-3xl uppercase text-zero-black tracking-tight">
            DOMANDE FREQUENTI SUI FONDI EUROPEI A REGGIO EMILIA
          </h2>
        </div>

        <div class="space-y-4">
          {faqs.map((faq, idx) => (
            <details class="group bg-zero-paper p-6 shadow-sm transition-all duration-300">
              <summary class="flex items-center justify-between font-display font-bold text-lg md:text-xl text-zero-black cursor-pointer select-none">
                <span>{faq.question}</span>
                <span class="font-mono text-zero-red text-xl transition-transform duration-300 group-open:rotate-45">+</span>
              </summary>
              <div class="pt-4 text-neutral-700 font-light text-sm md:text-base leading-relaxed border-t border-neutral-100 mt-4">
                {faq.answer}
              </div>
            </details>
          ))}
        </div>
      </section>

    </div>
  </div>
</BaseLayout>
