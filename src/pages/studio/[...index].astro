---
export function getStaticPaths() {
  return [
    { params: { index: undefined } },
    { params: { index: 'structure' } },
    { params: { index: 'desk' } },
    { params: { index: 'vision' } },
  ];
}
---

<!DOCTYPE html>
<html lang="it">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sanity Studio | VERACE</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <style is:global>
      html, body {
        height: 100%;
        width: 100%;
        margin: 0;
        padding: 0;
        background-color: #101112;
        color: #fff;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      }
      #sanity-root {
        height: 100%;
        width: 100%;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
      }
      .studio-loading {
        display: flex;
        align-items: center;
        justify-content: center;
        height: 100vh;
        width: 100vw;
        font-size: 14px;
        letter-spacing: 1px;
        text-transform: uppercase;
        color: #888;
      }
    </style>
  </head>
  <body>
    <div id="sanity-root">
      <div id="studio-loader" class="studio-loading">
        Caricamento Sanity Studio in corso...
      </div>
    </div>
    
    <script>
      import { renderStudio } from 'sanity';
      import config from '../../../sanity.config';

      const target = document.getElementById('sanity-root');
      const loader = document.getElementById('studio-loader');

      if (target) {
        try {
          renderStudio(target, config);
          if (loader) loader.remove();
        } catch (err) {
          console.error("Errore durante il rendering di Sanity Studio:", err);
          if (loader) {
            loader.innerHTML = `<div style="color: #ff5555; text-align: center; max-width: 500px; padding: 20px;">
              <p style="font-weight: bold; margin-bottom: 10px;">Impossibile avviare Sanity Studio</p>
              <pre style="font-size: 11px; background: #222; padding: 10px; border-radius: 4px; overflow: auto; text-align: left;">${err}</pre>
            </div>`;
          }
        }
      }
    </script>
  </body>
</html>
