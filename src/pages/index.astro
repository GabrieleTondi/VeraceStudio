---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import MagazineGrid from '../components/MagazineGrid.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getPosts, getProjects, getHeroSliderData } from '../lib/sanity';

const [posts, projects, heroSliderData] = await Promise.all([
  getPosts(),
  getProjects(),
  getHeroSliderData()
]);

const recentPosts = posts.slice(0, 3);
const featuredProjects = projects.slice(0, 3);
---

<BaseLayout
  title="VERACE | Media, Cultura e Rigenerazione Territoriale | Reggio Emilia"
  description="Piattaforma di rigenerazione urbana e innovazione sociale a Reggio Emilia e provincia. Supporto a imprese sui fondi europei (FSE+, FESR, PNRR), eventi culturali e inchieste sul territorio."
  keywords="VERACE, Reggio Emilia, fondi europei Reggio Emilia, bandi FSE+ FESR Emilia-Romagna, eventi Reggio Emilia, rigenerazione urbana, innovazione sociale, co-progettazione imprese, terzo settore Emilia"
>
  <!-- 1. Nuova Hero Home Page con Slider e Bottoni -->
  <Hero {...heroSliderData} />

  <div class="w-full px-4 sm:px-6 lg:px-8 py-16 md:py-24 space-y-20 md:space-y-28">
    
    <!-- 2. Sezione Progetti in Evidenza (Mantenuta la struttura e ingranditi i titoli) -->
    <section class="space-y-8 gsap-fade-up">
      <div class="flex flex-col md:flex-row md:items-end justify-between pb-4 gap-4">
        <div>
          <div class="text-xs font-mono font-bold text-zero-red uppercase tracking-widest mb-1">PROGETTI SUL TERRITORIO</div>
          <h2 class="text-4xl md:text-5xl lg:text-6xl font-black font-display uppercase tracking-tight text-zero-black">
            PROGETTI IN EVIDENZA
          </h2>
          <p class="text-xs font-mono text-neutral-500 mt-1 uppercase">INIZIATIVE ATTIVE DI RIGENERAZIONE E CULTURA</p>
        </div>
        <a
          href="/progetti"
          class="inline-flex items-center px-4 py-2 bg-zero-black text-white font-mono text-xs font-bold uppercase tracking-widest hover:bg-zero-red transition-colors shadow-sm"
        >
          VEDI TUTTI I PROGETTI →
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {featuredProjects.map((project) => (
          <ProjectCard project={project} />
        ))}
      </div>
    </section>

    <!-- 3. Sezione Articoli / Magazine (Mantenuta la struttura e ingranditi i titoli) -->
    <div class="gsap-fade-up">
      <MagazineGrid posts={recentPosts} title="ULTIME PUBBLICAZIONI" subtitle="DALLA REDAZIONE" />
    </div>

  </div>
</BaseLayout>
