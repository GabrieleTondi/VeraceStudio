---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import MagazineGrid from '../components/MagazineGrid.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getPosts, getProjects, getHeroSliderData } from '../lib/sanity';

const [posts, projects, heroSliderData] = await Promise.all([
  getPosts(),
  getProjects(),
  getHeroSliderData()
]);

const recentPosts = posts.slice(0, 3);
const featuredProjects = projects.slice(0, 4);
---

<BaseLayout
  title="VERACE | Media, Cultura e Rigenerazione Territoriale | Reggio Emilia"
  description="Piattaforma di rigenerazione urbana e innovazione sociale a Reggio Emilia e provincia. Supporto a imprese sui fondi europei (FSE+, FESR, PNRR), eventi culturali e inchieste sul territorio."
  keywords="VERACE, Reggio Emilia, fondi europei Reggio Emilia, bandi FSE+ FESR Emilia-Romagna, eventi Reggio Emilia, rigenerazione urbana, innovazione sociale, co-progettazione imprese, terzo settore Emilia"
>
  <!-- 1. Nuova Hero Home Page con Slider e Bottoni -->
  <Hero {...heroSliderData} />

  <div class="w-full px-4 sm:px-8 lg:px-12 py-24 md:py-36 lg:py-48 space-y-32 md:space-y-48 lg:space-y-56 max-w-[1600px] mx-auto">
    
    <!-- 2. Sezione Progetti (Griglia a 2 Colonne con Riquadri Ampi) -->
    <section class="space-y-6 md:space-y-8 gsap-fade-up">
      <div>
        <h2 class="text-4xl md:text-5xl lg:text-6xl font-black font-display uppercase tracking-tight text-zero-black">
          PROGETTI
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-12 md:gap-16 lg:gap-20">
        {featuredProjects.map((project) => (
          <ProjectCard project={project} />
        ))}
      </div>

      <!-- Bottone Centrato Sotto la Griglia -->
      <div class="flex justify-center pt-8 md:pt-12">
        <a
          href="/progetti"
          class="inline-flex items-center px-8 py-3.5 bg-zero-black text-white font-mono text-xs font-bold uppercase tracking-widest hover:bg-zero-red transition-colors shadow-sm"
        >
          VEDI TUTTI I PROGETTI →
        </a>
      </div>
    </section>

    <!-- 3. Sezione Articoli / Magazine -->
    <div class="gsap-fade-up">
      <MagazineGrid posts={recentPosts} title="MAGAZINE" subtitle="storie, racconti, reportage" />
    </div>

  </div>
</BaseLayout>
