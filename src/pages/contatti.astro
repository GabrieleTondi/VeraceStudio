---
import BaseLayout from '../layouts/BaseLayout.astro';

const siteOrigin = Astro.site ? Astro.site.origin : 'https://fondazioneverace.eu';

const contactSchema = {
  "@type": "ContactPage",
  "@id": `${siteOrigin}/contatti#contact`,
  "name": "Contatti & Sede Ufficiale | VERACE Reggio Emilia",
  "description": "Recapiti ufficiali, indirizzo della sede di Reggio Emilia, PEC, telefono e form di contatto per partnership B2B, fondi europei e proposte editoriali.",
  "mainEntity": {
    "@type": "LocalBusiness",
    "name": "VERACE",
    "telephone": "+39-0522-1234567",
    "email": "info@fondazioneverace.eu",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "Via Carlo Marx 53, Roncocesi",
      "addressLocality": "Reggio Emilia",
      "addressRegion": "Emilia-Romagna",
      "postalCode": "42124",
      "addressCountry": "IT"
    },
    "geo": {
      "@type": "GeoCoordinates",
      "latitude": 44.698274,
      "longitude": 10.631241
    }
  }
};
---

<BaseLayout
  title="Contatti & Sede Ufficiale | VERACE Reggio Emilia"
  description="Contatta la redazione, la segreteria o lo sportello Fondi Europei di VERACE a Reggio Emilia. Informazioni per partnership corporate, proposte editoriali e PEC."
  keywords="contatti VERACE, sede Reggio Emilia, email redazione, PEC VERACE, indirizzo Via San Zenone Reggio Emilia, telefono 0522"
  customSchema={contactSchema}
>
  <div class="w-full bg-zero-bg">
    <!-- Header Sezione Semplificato -->
    <header class="px-4 sm:px-8 lg:px-12 pt-12 md:pt-16 pb-12 border-b border-black/10 gsap-fade-up">
      <div class="max-w-[1600px] mx-auto">
        <h1 class="section-heading text-zero-black uppercase leading-none">
          CONTATTACI
        </h1>
      </div>
    </header>

    <div class="max-w-[1600px] mx-auto px-4 sm:px-8 lg:px-12 py-16 md:py-24 lg:py-32">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-20 items-start gsap-fade-up">
        
        <!-- Info di Contatto Tonale -->
        <div class="lg:col-span-5 space-y-8">
          <div class="space-y-8">
            <div class="font-mono text-xs text-zero-red font-bold uppercase tracking-wider">
              RECAPITI
            </div>
            
            <div>
              <h2 class="font-display font-black text-3xl uppercase text-zero-black tracking-tight leading-tight">
                SEDE<br/>CENTRALE
              </h2>
            </div>

            <div class="space-y-8 font-mono">
              <div>
                <div class="text-zero-black/60 font-bold text-xs uppercase tracking-wider mb-1.5">INDIRIZZO:</div>
                <div class="text-zero-black text-sm font-medium leading-relaxed uppercase">
                  VIA CARLO MARX 53, RONCOCESI - 42124 REGGIO EMILIA (RE), ITALIA
                </div>
              </div>

              <div>
                <div class="text-zero-black/60 font-bold text-xs uppercase tracking-wider mb-1.5">POSTA ELETTRONICA:</div>
                <div class="text-zero-black text-sm font-medium leading-relaxed">
                  <a href="mailto:info@fondazioneverace.eu" class="hover:text-zero-red transition-colors block">INFO@FONDAZIONEVERACE.EU</a>
                  <a href="mailto:fondazioneverace@pec.it" class="hover:text-zero-red transition-colors block mt-1">FONDAZIONEVERACE@PEC.IT <span class="text-xs text-neutral-500 font-normal">(PEC)</span></a>
                </div>
              </div>

              <div>
                <div class="text-zero-black/60 font-bold text-xs uppercase tracking-wider mb-1.5">SOCIAL MEDIA:</div>
                <div class="text-zero-black text-sm leading-relaxed">
                  <a
                    href="https://www.instagram.com/__verace__?igsh=MXBzbmxzM3A2emJsZg=="
                    target="_blank"
                    rel="noopener noreferrer"
                    class="hover:text-zero-red transition-colors inline-flex items-center gap-1 font-bold text-zero-red uppercase"
                  >
                    <span>→ INSTAGRAM: @__verace__</span>
                  </a>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Form Contatto Tonale -->
        <div class="lg:col-span-7">
          <div class="p-8 md:p-12 border border-black/10 bg-transparent">
            <form id="contact-form" class="space-y-6" novalidate>
              
              <!-- Status Feedback -->
              <div id="form-status" class="hidden p-4 font-mono text-xs font-bold text-white transition-all"></div>

              <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <!-- Nome -->
                <div class="space-y-2 relative group">
                  <label for="fullName" class="ui-meta text-xs text-zero-black font-bold block">NOME E COGNOME *</label>
                  <input
                    type="text"
                    id="fullName"
                    name="fullName"
                    required
                    placeholder="MARIO ROSSI"
                    class="w-full px-4 py-3.5 bg-transparent border border-black/20 focus:border-zero-black text-sm font-mono text-zero-black uppercase focus:outline-none transition-all placeholder:text-neutral-400"
                  />
                  <span class="font-mono text-[10px] text-zero-red font-bold absolute -bottom-5 left-0 hidden" id="error-fullName">CAMPO OBBLIGATORIO</span>
                </div>

                <!-- Email -->
                <div class="space-y-2 relative group">
                  <label for="email" class="ui-meta text-xs text-zero-black font-bold block">EMAIL *</label>
                  <input
                    type="email"
                    id="email"
                    name="email"
                    required
                    placeholder="MARIO@AZIENDA.IT"
                    class="w-full px-4 py-3.5 bg-transparent border border-black/20 focus:border-zero-black text-sm font-mono text-zero-black uppercase focus:outline-none transition-all placeholder:text-neutral-400"
                  />
                  <span class="font-mono text-[10px] text-zero-red font-bold absolute -bottom-5 left-0 hidden" id="error-email">EMAIL NON VALIDA</span>
                </div>
              </div>

              <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <!-- Azienda -->
                <div class="space-y-2">
                  <label for="organization" class="ui-meta text-xs text-zero-black font-bold block">AZIENDA (OPZIONALE)</label>
                  <input
                    type="text"
                    id="organization"
                    name="organization"
                    placeholder="TECHCORP SPA"
                    class="w-full px-4 py-3.5 bg-transparent border border-black/20 focus:border-zero-black text-sm font-mono text-zero-black uppercase focus:outline-none transition-all placeholder:text-neutral-400"
                  />
                </div>

                <!-- Oggetto -->
                <div class="space-y-2 relative group">
                  <label for="subject" class="ui-meta text-xs text-zero-black font-bold block">OGGETTO *</label>
                  <select
                    id="subject"
                    name="subject"
                    required
                    class="w-full px-4 py-3.5 bg-transparent border border-black/20 focus:border-zero-black text-sm font-mono text-zero-black uppercase focus:outline-none transition-all cursor-pointer"
                  >
                    <option value="">-- SELEZIONA --</option>
                    <option value="Proposta Partnership">PARTNERSHIP B2B</option>
                    <option value="Informazioni Generali">INFORMAZIONI</option>
                    <option value="Magazine Editoriale">REDAZIONE MAGAZINE</option>
                    <option value="Altro">ALTRO</option>
                  </select>
                  <span class="font-mono text-[10px] text-zero-red font-bold absolute -bottom-5 left-0 hidden" id="error-subject">SELEZIONA OGGETTO</span>
                </div>
              </div>

              <!-- Messaggio -->
              <div class="space-y-2 relative group">
                <label for="message" class="ui-meta text-xs text-zero-black font-bold block">MESSAGGIO *</label>
                <textarea
                  id="message"
                  name="message"
                  rows="5"
                  required
                  placeholder="SCRIVI QUI IL TUO MESSAGGIO..."
                  class="w-full px-4 py-3.5 bg-transparent border border-black/20 focus:border-zero-black text-sm font-mono text-zero-black uppercase focus:outline-none transition-all resize-none placeholder:text-neutral-400"
                ></textarea>
                <span class="font-mono text-[10px] text-zero-red font-bold absolute -bottom-5 left-0 hidden" id="error-message">MESSAGGIO TROPPO CORTO</span>
              </div>

              <!-- Privacy -->
              <div class="relative pt-2">
                <div class="flex items-start gap-3">
                  <input
                    type="checkbox"
                    id="privacy"
                    name="privacy"
                    required
                    class="mt-1 w-4 h-4 accent-zero-red cursor-pointer"
                  />
                  <label for="privacy" class="font-mono text-xs text-zero-black/80 leading-snug cursor-pointer select-none">
                    ACCONSENTO AL TRATTAMENTO DEI DATI AI SENSI DEL GDPR (UE 2016/679). *
                  </label>
                </div>
                <span class="font-mono text-[10px] text-zero-red font-bold absolute -bottom-5 left-7 hidden" id="error-privacy">ACCETTAZIONE RICHIESTA</span>
              </div>

              <!-- Submit Button -->
              <button
                type="submit"
                class="w-full py-4 mt-4 bg-zero-black text-white font-mono font-bold text-xs uppercase tracking-widest hover:bg-zero-red transition-colors duration-300 shadow-sm hover:shadow-md cursor-pointer flex items-center justify-center gap-2"
              >
                <span>INVIA MESSAGGIO</span>
                <span>→</span>
              </button>
            </form>
          </div>
        </div>

      </div>
    </div>
  </div>
</BaseLayout>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const statusDiv = document.getElementById('form-status') as HTMLDivElement;

  if (form) {
    const urlParams = new URLSearchParams(window.location.search);
    const progettoParam = urlParams.get('progetto');
    const objParam = urlParams.get('oggetto');

    if (progettoParam) {
      const messageInput = document.getElementById('message') as HTMLTextAreaElement;
      if (messageInput) {
        messageInput.value = `In merito a "${progettoParam}":\n\n`;
      }
    }

    if (objParam) {
      const subjectSelect = document.getElementById('subject') as HTMLSelectElement;
      if (subjectSelect) {
        for (let i = 0; i < subjectSelect.options.length; i++) {
          const opt = subjectSelect.options[i];
          if (opt.value.toLowerCase().includes(objParam.toLowerCase()) || opt.text.toLowerCase().includes(objParam.toLowerCase())) {
            subjectSelect.selectedIndex = i;
            break;
          }
        }
      }
    }

    form.addEventListener('submit', (e) => {
      e.preventDefault();

      const errorIds = ['fullName', 'email', 'subject', 'message', 'privacy'];
      let isValid = true;

      errorIds.forEach((id) => {
        const errorEl = document.getElementById(`error-${id}`);
        if (errorEl) errorEl.classList.add('hidden');
      });

      const fullName = (document.getElementById('fullName') as HTMLInputElement).value.trim();
      const email = (document.getElementById('email') as HTMLInputElement).value.trim();
      const subject = (document.getElementById('subject') as HTMLSelectElement).value;
      const message = (document.getElementById('message') as HTMLTextAreaElement).value.trim();
      const privacy = (document.getElementById('privacy') as HTMLInputElement).checked;

      if (!fullName) {
        document.getElementById('error-fullName')?.classList.remove('hidden');
        isValid = false;
      }

      if (!email || !email.includes('@') || !email.includes('.')) {
        document.getElementById('error-email')?.classList.remove('hidden');
        isValid = false;
      }

      if (!subject) {
        document.getElementById('error-subject')?.classList.remove('hidden');
        isValid = false;
      }

      if (!message || message.length < 10) {
        document.getElementById('error-message')?.classList.remove('hidden');
        isValid = false;
      }

      if (!privacy) {
        document.getElementById('error-privacy')?.classList.remove('hidden');
        isValid = false;
      }

      if (isValid) {
        statusDiv.className = 'p-4 font-mono text-xs font-bold bg-zero-black text-white block mb-6 shadow-sm';
        statusDiv.innerHTML = 'MESSAGGIO INVIATO CON SUCCESSO.<br/><span class="text-neutral-300 font-normal mt-1 block">La redazione risponderà entro 24 ore.</span>';
        form.reset();
        window.scrollTo({ top: form.offsetTop - 100, behavior: 'smooth' });
      } else {
        statusDiv.className = 'p-4 font-mono text-xs font-bold bg-zero-red text-white block mb-6 shadow-sm';
        statusDiv.textContent = 'ERRORE: VERIFICA I CAMPI OBBLIGATORI.';
      }
    });
  }
</script>
