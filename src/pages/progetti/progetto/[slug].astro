---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getProjects, type Project, urlFor } from '../../../lib/sanity';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project) => ({
    params: { slug: project.slug?.current || 'la-bela' },
    props: { project },
  }));
}

interface Props {
  project: Project;
}

const { project } = Astro.props;

const galleryImages = (project.galleryUrls && project.galleryUrls.length > 0)
  ? project.galleryUrls
  : ((project.gallery && project.gallery.length > 0)
      ? project.gallery.map((g: any) => g.asset?.url || (g.asset?._ref ? urlFor(g)?.url() : null)).filter(Boolean)
      : ['/projects/LA BELA/IMG_4931.webp']);

const coverImg = galleryImages.length > 0 ? galleryImages[0] : '/projects/LA BELA/IMG_4931.webp';
const siteOrigin = Astro.site ? Astro.site.origin : 'https://fondazioneverace.eu';

const projectSchema = {
  "@type": "CreativeWork",
  "@id": `${siteOrigin}/progetti/progetto/${project.slug?.current || 'la-bela'}#project`,
  "name": project.title,
  "headline": project.title,
  "description": project.summary,
  "image": coverImg.startsWith('http') ? coverImg : `${siteOrigin}${coverImg}`,
  "creator": {
    "@type": "NGO",
    "name": "VERACE",
    "url": siteOrigin
  },
  "sponsor": (project.partners || []).map((partner: string) => ({
    "@type": "Organization",
    "name": partner
  }))
};
---

<BaseLayout
  title={`${project.title} | Progetti Territoriali Reggio Emilia | VERACE`}
  description={`${project.summary} - Iniziativa promossa da VERACE a Reggio Emilia e provincia.`}
  keywords={`progetti Reggio Emilia, ${project.title}, ${project.partners?.join(', ') || ''}, rigenerazione urbana, VERACE`}
  image={coverImg}
  customSchema={projectSchema}
>
  <div class="w-full bg-zero-bg">
    
    <!-- Top Horizontal Navigation Ribbon -->
    <div class="bg-zero-paper px-4 sm:px-6 lg:px-8 py-4 flex items-center justify-between text-xs ui-meta">
      <a href="/progetti" class="text-zero-black font-bold hover:text-zero-red transition-colors flex items-center gap-2">
        <span>← TORNA A TUTTI I PROGETTI</span>
      </a>
      <div class="flex items-center gap-3">
        <span class="text-neutral-500 uppercase">Stato:</span>
        <span class="font-bold text-zero-red bg-zero-bg px-2.5 py-1 shadow-sm">{project.status}</span>
      </div>
    </div>

    <!-- Widescreen Hero Banner (21/9 Layout Orizzontale) -->
    <div class="relative w-full overflow-hidden bg-zero-black group/hero">
      <div class="absolute inset-0 z-10 bg-gradient-to-t from-black via-black/40 to-transparent"></div>
      <img
        src={coverImg}
        alt={`Copertina progetto: ${project.title}`}
        class="w-full aspect-[21/9] min-h-[350px] max-h-[600px] object-cover opacity-90 group-hover/hero:opacity-100 group-hover/hero:scale-105 transition-all duration-700"
      />
      <div class="absolute bottom-0 left-0 right-0 z-20 p-6 sm:p-10 lg:p-16 max-w-7xl mx-auto space-y-4">
        <h1 class="font-display font-black text-3xl sm:text-5xl lg:text-6xl text-white uppercase leading-none tracking-tight">
          {project.title}
        </h1>
        <p class="text-lg sm:text-2xl text-neutral-200 font-light max-w-4xl leading-relaxed">
          {project.summary}
        </p>
      </div>
    </div>

    <!-- Horizontal Specifications Ribbon Bar (3 Colonne pulite, senza documentazione e senza conteggio numerico enti) -->
    <div class="bg-zero-paper py-10 md:py-14 px-4 sm:px-6 lg:px-8">
      <div class="max-w-7xl mx-auto grid grid-cols-1 sm:grid-cols-3 gap-8 ui-meta">
        <div class="border-l-2 border-zero-red pl-4 py-1 space-y-2">
          <div class="text-neutral-500 text-xs uppercase tracking-wider">STATO ESECUZIONE</div>
          <div class="font-bold text-zero-black text-sm sm:text-base">{project.status}</div>
        </div>
        <div class="border-l-2 border-zero-red pl-4 py-1 space-y-2">
          <div class="text-neutral-500 text-xs uppercase tracking-wider">PARTNERSHIP</div>
          <div class="font-bold text-zero-black text-sm sm:text-base">Rete di Territorio</div>
        </div>
        <div class="border-l-2 border-zero-red pl-4 py-1 space-y-2">
          <div class="text-neutral-500 text-xs uppercase tracking-wider">CATEGORIA</div>
          <div class="font-bold text-zero-black text-sm sm:text-base">Rigenerazione & Cultura</div>
        </div>
      </div>
    </div>

    <!-- Main Content Horizontal Split Grid -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 md:py-16">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start">
        
        <!-- Left Column: Executive Summary & Description -->
        <div class="lg:col-span-7 space-y-10">
          <section class="space-y-6">
            <h2 class="ui-meta font-bold text-zero-red pb-2 text-sm uppercase">
              SINTESI ESECUTIVA DEL PROGETTO
            </h2>
            <div class="prose prose-lg prose-p:font-light prose-p:text-zero-black prose-p:leading-relaxed max-w-none space-y-6">
              <p class="text-xl font-normal text-zero-black leading-relaxed">
                {project.summary}
              </p>
              <p>
                Il progetto si sviluppa in continuità con la visione strategica di VERACE per favorire la riscoperta delle filiere territoriali, la rigenerazione degli spazi ed il coinvolgimento diretto delle giovani generazioni.
              </p>
              <p>
                Attraverso un approccio partecipativo e multidisciplinare, l'iniziativa mette in rete istituzioni pubbliche, aziende private sostenitrici ed organizzazioni locali per garantire un impatto duraturo ed accrescere la coesione sociale del territorio.
              </p>
            </div>
          </section>

          <!-- Partners Section (Senza conteggio numerico, solo nomi dei partner) -->
          {project.partners && project.partners.length > 0 && (
            <section class="pt-8 mt-8 space-y-6">
              <div class="pb-2">
                <h2 class="ui-meta font-bold text-zero-red text-sm uppercase">
                  RETE DEI PARTNER
                </h2>
              </div>
              
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                {project.partners.map((partner) => (
                  <div class="p-4 bg-zero-paper shadow-sm flex items-center justify-between group">
                    <span class="font-display font-bold uppercase text-sm text-zero-black group-hover:text-zero-red transition-colors">
                      {partner}
                    </span>
                    <span class="ui-meta text-xs text-zero-black font-mono font-bold bg-zero-bg px-2 py-0.5">
                      PARTNER
                    </span>
                  </div>
                ))}
              </div>
            </section>
          )}
        </div>

        <!-- Right Column: Widescreen Gallery & Actions (Senza indicazione conteggio scatti) -->
        <div class="lg:col-span-5 space-y-8 lg:sticky lg:top-24">
          <div class="space-y-4">
            <h2 class="ui-meta font-bold text-zero-red pb-2 text-sm uppercase">
              GALLERIA FOTOGRAFICA
            </h2>

            <!-- Gallery Grid Layout -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              {galleryImages.map((imgUrl, index) => (
                <div
                  class="group relative overflow-hidden bg-black aspect-[4/3] cursor-pointer gallery-modal-trigger shadow-sm"
                  data-img-src={imgUrl}
                  data-img-index={index}
                >
                  <img
                    src={imgUrl}
                    alt={`Foto del progetto ${project.title}`}
                    class="w-full h-full object-cover grayscale group-hover:grayscale-0 group-hover:scale-108 transition-all duration-500"
                    loading="lazy"
                  />
                  <div class="absolute inset-0 bg-black/40 group-hover:bg-black/10 transition-colors flex items-center justify-center opacity-0 group-hover:opacity-100">
                    <span class="p-2 bg-zero-red text-white text-xs font-bold ui-meta">
                      INGRANDISCI ⤢
                    </span>
                  </div>
                </div>
              ))}
            </div>
          </div>

          <!-- Contact Action Card -->
          <div class="p-6 bg-zero-paper shadow-sm space-y-4">
            <h3 class="ui-meta font-bold text-zero-red pb-2 text-xs uppercase">
              PARTECIPA O SOSTIENI
            </h3>
            <p class="text-xs text-zero-black font-light leading-relaxed">
              Vuoi collaborare a questo progetto o richiedere maggiori dettagli operativi?
            </p>
            <a
              href={`/contatti?progetto=${encodeURIComponent(project.title)}&oggetto=Informazioni`}
              class="block w-full text-center py-3 bg-zero-red text-white hover:bg-zero-black ui-meta font-bold text-xs transition-colors shadow-sm"
            >
              INVIA RICHIESTA INFORMAZIONI →
            </a>
          </div>
        </div>

      </div>
    </div>
  </div>

  <!-- Lightbox Modal for Project Gallery Carousel -->
  <div
    id="project-lightbox-modal"
    class="fixed inset-0 z-50 flex items-center justify-center bg-black/90 backdrop-blur-md hidden p-4 sm:p-8"
  >
    <button
      id="project-lightbox-close"
      class="absolute top-4 right-4 z-30 text-white bg-black/70 hover:bg-zero-red p-3 transition-colors focus:outline-none cursor-pointer"
      aria-label="Chiudi galleria"
    >
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
    </button>

    <button
      id="project-lightbox-prev"
      class="absolute left-4 top-1/2 -translate-y-1/2 z-30 text-white bg-black/70 hover:bg-zero-red p-3 sm:p-4 transition-colors focus:outline-none cursor-pointer"
      aria-label="Foto precedente"
    >
      <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
    </button>

    <button
      id="project-lightbox-next"
      class="absolute right-4 top-1/2 -translate-y-1/2 z-30 text-white bg-black/70 hover:bg-zero-red p-3 sm:p-4 transition-colors focus:outline-none cursor-pointer"
      aria-label="Foto successiva"
    >
      <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
    </button>

    <div class="relative max-w-5xl max-h-[85vh] flex flex-col items-center justify-center">
      <img
        id="project-lightbox-img"
        src=""
        alt="Foto ingrandita progetto"
        class="max-w-full max-h-[75vh] object-contain shadow-2xl transition-all duration-300"
      />
      <div class="mt-4 flex items-center justify-end w-full text-white ui-meta px-2">
        <span class="text-neutral-400 text-xs hidden sm:inline">Usa le frecce della tastiera (← →) per navigare</span>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  function initProjectGalleryLightbox() {
    const modalTriggers = document.querySelectorAll('.gallery-modal-trigger');
    const lightboxModal = document.getElementById('project-lightbox-modal');
    const lightboxImg = document.getElementById('project-lightbox-img') as HTMLImageElement | null;
    const lightboxClose = document.getElementById('project-lightbox-close');
    const lightboxPrev = document.getElementById('project-lightbox-prev');
    const lightboxNext = document.getElementById('project-lightbox-next');

    const images: string[] = Array.from(modalTriggers).map(trig => trig.getAttribute('data-img-src') || '');
    let currentIndex = 0;

    if (modalTriggers.length > 0 && lightboxModal && lightboxImg) {
      const updateLightbox = (index: number) => {
        if (index < 0) index = images.length - 1;
        if (index >= images.length) index = 0;
        currentIndex = index;

        lightboxImg.src = images[currentIndex];
      };

      const openLightbox = (index: number) => {
        updateLightbox(index);
        lightboxModal.classList.remove('hidden');
        document.body.style.overflow = 'hidden';
      };

      const closeLightbox = () => {
        lightboxModal.classList.add('hidden');
        document.body.style.overflow = '';
      };

      modalTriggers.forEach((trig, idx) => {
        if (!trig.getAttribute('data-bound')) {
          trig.setAttribute('data-bound', 'true');
          trig.addEventListener('click', () => {
            openLightbox(idx);
          });
        }
      });

      if (lightboxClose && !lightboxClose.getAttribute('data-bound')) {
        lightboxClose.setAttribute('data-bound', 'true');
        lightboxClose.addEventListener('click', closeLightbox);
      }

      if (lightboxPrev && !lightboxPrev.getAttribute('data-bound')) {
        lightboxPrev.setAttribute('data-bound', 'true');
        lightboxPrev.addEventListener('click', () => updateLightbox(currentIndex - 1));
      }

      if (lightboxNext && !lightboxNext.getAttribute('data-bound')) {
        lightboxNext.setAttribute('data-bound', 'true');
        lightboxNext.addEventListener('click', () => updateLightbox(currentIndex + 1));
      }

      if (!lightboxModal.getAttribute('data-bound')) {
        lightboxModal.setAttribute('data-bound', 'true');
        lightboxModal.addEventListener('click', (e) => {
          if (e.target === lightboxModal) closeLightbox();
        });
      }

      document.addEventListener('keydown', (e) => {
        if (lightboxModal.classList.contains('hidden')) return;
        if (e.key === 'Escape') closeLightbox();
        if (e.key === 'ArrowLeft') updateLightbox(currentIndex - 1);
        if (e.key === 'ArrowRight') updateLightbox(currentIndex + 1);
      });
    }
  }

  document.addEventListener('DOMContentLoaded', initProjectGalleryLightbox);
  document.addEventListener('astro:page-load', initProjectGalleryLightbox);
</script>
