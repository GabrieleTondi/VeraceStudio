---
import BaseLayout from '../layouts/BaseLayout.astro';
import TeamMemberCard from '../components/TeamMemberCard.astro';
import DownloadButton from '../components/DownloadButton.astro';
import { getTeamMembers, getCollaborators } from '../lib/sanity';

const members = await getTeamMembers();
const collaborators = await getCollaborators();
const siteOrigin = Astro.site ? Astro.site.origin : 'https://fondazioneverace.eu';

const aboutSchema = {
  "@type": "AboutPage",
  "@id": `${siteOrigin}/team#about`,
  "name": "Chi Siamo & Team | VERACE",
  "description": "Piattaforma indipendente fondata nel 2025 da un team under 30 composto da urbanisti, architetti e fotografi a Reggio Emilia.",
  "mainEntity": {
    "@type": "Organization",
    "name": "VERACE",
    "url": siteOrigin
  }
};
---

<BaseLayout
  title="Chi Siamo, Team & Trasparenza | VERACE Reggio Emilia"
  description="Scopri chi siamo: piattaforma indipendente fondata nel 2025 da urbanisti, architetti e fotografi per attivare il territorio di Reggio Emilia."
  keywords="chi siamo VERACE, team VERACE, urbanisti Reggio Emilia, architetti terzo settore, rigenerazione urbana Emilia Romagna, trasparenza bilancio"
  customSchema={aboutSchema}
>
  <div class="w-full bg-zero-bg">
    
    <!-- A) Apertura Pagina: Sezione "CHI SIAMO" -->
    <header class="px-4 sm:px-8 lg:px-12 pt-12 md:pt-16 pb-12 border-b border-black/10 gsap-fade-up">
      <div class="max-w-[1600px] mx-auto grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start">
        <div class="lg:col-span-5">
          <h1 class="section-heading text-zero-black uppercase leading-none">
            CHI SIAMO
          </h1>
        </div>
        <div class="lg:col-span-7">
          <p class="text-base md:text-lg font-light text-zero-black leading-relaxed">
            Verace è una piattaforma indipendente fondata nel 2025 da un team under 30 composto da urbanisti, architetti e fotografi con l’obiettivo di contribuire ad attivare il territorio di Reggio Emilia attraverso progetti culturali, media e di rigenerazione urbana. Lavoriamo con team multidisciplinari collaborando con imprese, fondazioni e enti no-profit.
          </p>
        </div>
      </div>
    </header>

    <div class="max-w-[1600px] mx-auto px-4 sm:px-8 lg:px-12 py-16 md:py-24 lg:py-32 space-y-24 md:space-y-36">
      
      <!-- B) Sezione TEAM: Schede dei membri con foto e descrizioni -->
      <section class="space-y-12 md:space-y-16 gsap-fade-up">
        <div class="pb-6 border-b border-black/10 flex items-end justify-between">
          <h2 class="font-display font-black text-3xl md:text-4xl uppercase text-zero-black tracking-tight leading-none">
            TEAM
          </h2>
          <span class="ui-meta text-zero-red font-bold text-xs uppercase tracking-wider">{members.length} MEMBRI</span>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8 md:gap-10 lg:gap-12">
          {members.map((member, idx) => (
            <TeamMemberCard member={member} index={idx} />
          ))}
        </div>
      </section>

      <!-- C) Sezione COLLABORATORI -->
      {collaborators && collaborators.length > 0 && (
        <section class="space-y-12 md:space-y-16 gsap-fade-up">
          <div class="pb-6 border-b border-black/10 flex items-end justify-between">
            <h2 class="font-display font-black text-3xl md:text-4xl uppercase text-zero-black tracking-tight leading-none">
              COLLABORATORI
            </h2>
            <span class="ui-meta text-zero-red font-bold text-xs uppercase tracking-wider">{collaborators.length} COLLABORATORI</span>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8 md:gap-10 lg:gap-12">
            {collaborators.map((collaborator, idx) => (
              <TeamMemberCard member={collaborator} index={idx + members.length} />
            ))}
          </div>
        </section>
      )}

      <!-- D) Sezione TRASPARENZA (Subito dopo il Team con tasto 'scarica il bilancio 2025') -->
      <section class="border border-black/10 p-8 md:p-14 space-y-8 bg-transparent gsap-fade-up">
        <div class="max-w-3xl space-y-3">
          <div class="ui-meta text-zero-red font-bold text-xs uppercase tracking-wider">ADEMPIMENTI NORMATIVI & RENDICONTAZIONE</div>
          <h2 class="font-display font-black text-2xl md:text-3xl uppercase text-zero-black tracking-tight">
            TRASPARENZA
          </h2>
          <p class="text-base text-zero-black/85 font-light leading-relaxed">
            In ottemperanza agli obblighi di trasparenza, pubblicità e rendicontazione previsti per gli enti del Terzo Settore (D.Lgs. 117/2017 e L. 124/2017), VERACE pubblica annualmente il proprio bilancio d'esercizio, i contributi pubblici ricevuti e la relazione di impatto sulle attività svolte sul territorio.
          </p>
        </div>

        <div class="pt-6 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6 border-t border-black/10">
          <div class="font-mono text-xs text-zero-black/60 uppercase">
            DOCUMENTO UFFICIALE DEPOSITATO AL REGISTRO UNICO NAZIONALE DEL TERZO SETTORE
          </div>
          <a
            href="/pdf/sample-project-presentation.pdf"
            download
            class="inline-flex items-center justify-center gap-3 px-8 py-4 bg-zero-black text-white ui-meta font-bold text-xs uppercase tracking-widest hover:bg-zero-red transition-colors duration-300 shadow-sm cursor-pointer"
          >
            <span>scarica il bilancio 2025</span>
            <span>↓</span>
          </a>
        </div>
      </section>

    </div>
  </div>
</BaseLayout>
