---
import BaseLayout from '../layouts/BaseLayout.astro';
import TeamMemberCard from '../components/TeamMemberCard.astro';
import DownloadButton from '../components/DownloadButton.astro';
import { getTeamMembers } from '../lib/sanity';

const members = await getTeamMembers();
const siteOrigin = Astro.site ? Astro.site.origin : 'https://fondazioneverace.eu';

const aboutSchema = {
  "@type": "AboutPage",
  "@id": `${siteOrigin}/team#about`,
  "name": "Chi Siamo & Team | VERACE",
  "description": "Piattaforma indipendente fondata nel 2025 da un team under 30 composto da urbanisti, architetti e fotografi a Reggio Emilia.",
  "mainEntity": {
    "@type": "Organization",
    "name": "VERACE",
    "url": siteOrigin
  }
};
---

<BaseLayout
  title="Chi Siamo, Team & Trasparenza | VERACE Reggio Emilia"
  description="Scopri chi siamo: piattaforma indipendente fondata nel 2025 da urbanisti, architetti e fotografi per attivare il territorio di Reggio Emilia."
  keywords="chi siamo VERACE, team VERACE, urbanisti Reggio Emilia, architetti terzo settore, rigenerazione urbana Emilia Romagna, trasparenza bilancio"
  customSchema={aboutSchema}
>
  <div class="w-full bg-zero-bg">
    
    <!-- A) Apertura Pagina: Sezione "CHI SIAMO" -->
    <header class="px-4 sm:px-6 lg:px-8 py-12 md:py-16 lg:py-20 bg-zero-paper gsap-fade-up">
      <div class="max-w-7xl mx-auto flex flex-col md:flex-row md:items-center justify-between gap-8">
        <div>
          <h1 class="hero-headline text-zero-black uppercase">
            CHI SIAMO
          </h1>
        </div>
        <div class="max-w-xl">
          <p class="text-base md:text-lg font-light text-zero-black leading-relaxed">
            Verace è una piattaforma indipendente fondata nel 2025 da un team under 30 composto da urbanisti, architetti e fotografi con l’obiettivo di contribuire ad attivare il territorio attraverso progetti culturali, media e di rigenerazione urbana. Di base a Reggio Emilia, lavoriamo con team multidisciplinari collaborando con imprese, fondazioni e enti no-profit.
          </p>
        </div>
      </div>
    </header>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 lg:py-24 space-y-20">
      
      <!-- B) Sezione TEAM: Schede dei membri con foto e descrizioni -->
      <section class="space-y-10 gsap-fade-up">
        <div class="pb-2">
          <div class="ui-meta text-zero-red font-bold mb-1">MEMBRI & CURATORI</div>
          <h2 class="font-display font-black text-3xl md:text-4xl uppercase text-zero-black tracking-tight">
            IL TEAM
          </h2>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
          {members.map((member, idx) => (
            <TeamMemberCard member={member} index={idx} />
          ))}
        </div>
      </section>

      <!-- C) Sezione TRASPARENZA (Subito dopo il Team con tasto 'scarica il bilancio 2025') -->
      <section class="bg-zero-paper p-8 md:p-14 space-y-8 shadow-sm gsap-fade-up">
        <div class="max-w-3xl space-y-3">
          <div class="ui-meta text-zero-red font-bold">ADEMPIMENTI NORMATIVI & RENDICONTAZIONE</div>
          <h2 class="font-display font-black text-2xl md:text-3xl uppercase text-zero-black tracking-tight">
            TRASPARENZA
          </h2>
          <p class="text-base text-neutral-800 font-light leading-relaxed">
            In ottemperanza agli obblighi di trasparenza, pubblicità e rendicontazione previsti per gli enti del Terzo Settore (D.Lgs. 117/2017 e L. 124/2017), VERACE pubblica annualmente il proprio bilancio d'esercizio, i contributi pubblici ricevuti e la relazione di impatto sulle attività svolte sul territorio.
          </p>
        </div>

        <div class="pt-4 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6 border-t border-neutral-200">
          <div class="font-mono text-xs text-neutral-600 uppercase">
            DOCUMENTO UFFICIALE DEPOSITATO AL REGISTRO UNICO NAZIONALE DEL TERZO SETTORE          </div>
          <a
            href="/pdf/sample-project-presentation.pdf"
            download
            class="inline-flex items-center justify-center gap-3 px-8 py-4 bg-zero-red text-white ui-meta font-bold text-xs uppercase hover:bg-zero-black transition-colors duration-300 shadow-sm cursor-pointer"
          >
            <span>scarica il bilancio 2025</span>
            <span>↓</span>
          </a>
        </div>
      </section>

    </div>
  </div>
</BaseLayout>
