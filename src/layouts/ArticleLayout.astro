---
import BaseLayout from './BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import type { Post } from '../lib/sanity';
import { getPosts } from '../lib/sanity';

interface Props {
  post: Post;
  suggestedPosts?: Post[];
}

const { post, suggestedPosts: initialSuggested } = Astro.props;

let suggestedPosts = initialSuggested || [];
if (suggestedPosts.length === 0) {
  try {
    suggestedPosts = allPosts.filter((p) => p.slug.current !== post.slug.current);
  } catch (err) {
    console.warn('Fallback fetching suggested posts:', err);
  }
}

const formattedDate = new Date(post.publishedAt).toLocaleDateString('it-IT', {
  day: '2-digit',
  month: '2-digit',
  year: 'numeric'
});

const siteOrigin = Astro.site ? Astro.site.origin : 'https://fondazioneverace.eu';

function getYouTubeEmbedUrl(url?: string) {
  if (!url) return null;
  const regExp = /^.*(youtu.be\/|v\/|u\/\w\/|embed\/|watch\?v=|\&v=)([^#\&\?]*).*/;
  const match = url.match(regExp);
  return (match && match[2].length === 11) ? `https://www.youtube.com/embed/${match[2]}?autoplay=1` : url;
}

const videoEmbedUrl = getYouTubeEmbedUrl(post.videoUrl);

const authorName = post.authorInfo?.name || post.author || "Redazione VERACE";

const articleSchema = {
  "@type": "NewsArticle",
  "@id": `${siteOrigin}/magazine/articolo/${post.slug.current}#article`,
  "headline": post.title,
  "description": post.subtitle || post.title,
  "image": post.coverImageUrl ? [post.coverImageUrl] : [`${siteOrigin}/images/verace-og.jpg`],
  "datePublished": post.publishedAt,
  "dateModified": post.publishedAt,
  "articleSection": post.category || 'Inchieste',
  "inLanguage": "it-IT",
  "author": {
    "@type": "Organization",
    "name": authorName,
    "url": siteOrigin
  },
  "publisher": {
    "@type": "Organization",
    "name": "VERACE",
    "url": siteOrigin,
    "logo": {
      "@type": "ImageObject",
      "url": `${siteOrigin}/logos/Verace_Logo_Verde.png`
    }
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": `${siteOrigin}/magazine/articolo/${post.slug.current}`
  }
};

const pageKeywords = `${post.category || 'Inchieste'}, VERACE, magazine, territorio Reggio Emilia, ${post.title}`;

const galleryImages = post.galleryUrls || [];
const hasStructuredBlocks = post.contentBlocks && post.contentBlocks.length > 0;
const bodyBlocks = post.body || [];

// Fallback legacy content pairs se l'articolo non ha contentBlocks dedicati
const fallbackPairs: { text: string; image?: string }[] = [];
if (!hasStructuredBlocks && bodyBlocks.length > 0) {
  bodyBlocks.forEach((block: any, idx: number) => {
    if (block._type === 'block') {
      const textContent = block.children?.map((c: any) => c.text).join('') || '';
      const associatedImage = (galleryImages.length > idx && galleryImages[idx] !== post.coverImageUrl)
        ? galleryImages[idx]
        : undefined;
      fallbackPairs.push({ text: textContent, image: associatedImage });
    }
  });
}

// Helper per il rendering HTML dei blocchi di testo con formattazione ricca (grassetti, colori, capolettera, link)
function renderBlockHtml(block: any, isFirstText: boolean) {
  if (Array.isArray(block.children) && block.children.length > 0) {
    const markDefsMap = new Map();
    if (Array.isArray(block.markDefs)) {
      block.markDefs.forEach((def: any) => markDefsMap.set(def._key, def));
    }

    const htmlSpans = block.children.map((child: any, spanIdx: number) => {
      let text = child.text || '';
      if (!text) return '';
      // Escape HTML
      text = text.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');

      const marks: string[] = child.marks || [];
      const isDropCap = marks.includes('dropCap');
      let customColorStyle = '';
      let linkHref = '';

      marks.forEach((m) => {
        const def = markDefsMap.get(m);
        if (def) {
          if (def._type === 'link' || def.href) linkHref = def.href;
          if (def._type === 'customColor' || def.color) customColorStyle = `color: ${def.color};`;
        }
      });

      if (marks.includes('strong')) text = `<strong class="font-bold text-zero-black">${text}</strong>`;
      if (marks.includes('em')) text = `<em class="italic">${text}</em>`;
      if (marks.includes('underline')) text = `<span class="underline underline-offset-4 decoration-zero-red">${text}</span>`;
      if (marks.includes('strike-through')) text = `<s class="line-through opacity-75">${text}</s>`;
      if (marks.includes('colorRed')) text = `<span class="text-zero-red font-bold">${text}</span>`;
      if (marks.includes('colorDark')) text = `<span class="text-zero-black font-bold">${text}</span>`;
      if (marks.includes('colorGreen')) text = `<span class="text-emerald-800 font-bold">${text}</span>`;
      if (marks.includes('colorGray')) text = `<span class="text-[#55504E]">${text}</span>`;

      if (customColorStyle) {
        text = `<span style="${customColorStyle}" class="font-bold">${text}</span>`;
      }

      if (linkHref) {
        text = `<a href="${linkHref}" target="_blank" rel="noopener noreferrer" class="text-zero-red underline font-medium hover:text-zero-black transition-colors">${text}</a>`;
      }

      if (isDropCap && spanIdx === 0 && text.length > 0) {
        const firstLetter = text.charAt(0);
        const rest = text.slice(1);
        text = `<span class="float-left text-6xl font-display font-bold mr-4 text-zero-red leading-none mt-1 select-none">${firstLetter}</span>${rest}`;
      }

      return text;
    });

    return htmlSpans.join('');
  }

  return block.content || '';
}
---

<BaseLayout
  title={`${post.title} | Magazine VERACE`}
  description={post.subtitle || `${post.title} - Inchiesta edita da VERACE.`}
  keywords={pageKeywords}
  image={post.coverImageUrl || '/images/verace-og.jpg'}
  article={true}
  publishedTime={post.publishedAt}
  customSchema={articleSchema}
>
  <article class="w-full relative" itemscope itemtype="https://schema.org/NewsArticle">
    
    <!-- 1. HEADER ARTICOLO -->
    <header class="bg-zero-bg pt-16 md:pt-28 pb-12 md:pb-16 px-4 sm:px-6 lg:px-8 gsap-fade-up">
      <div class="max-w-4xl mx-auto space-y-8">
        <div class="flex items-center justify-between gap-4 flex-wrap">
          <span class="ui-meta text-zero-red font-bold">
            {post.category || 'INCHIESTA'}
          </span>
          <div class="flex items-center gap-4 text-xs font-mono text-zero-black/60">
            <time datetime={post.publishedAt} itemprop="datePublished">
              {formattedDate}
            </time>
          </div>
        </div>

        <h1 itemprop="headline" class="hero-headline text-zero-black uppercase leading-[0.9]">
          {post.title}
        </h1>

        {post.subtitle && (
          <p itemprop="description" class="text-xl md:text-2xl font-bold text-zero-black leading-relaxed">
            {post.subtitle}
          </p>
        )}

        <!-- Sezione Intervistati e Autori nell'Header -->
        <div class="pt-6 border-t border-neutral-200/80 space-y-3">
          {post.interviewees && post.interviewees.length > 0 && (
            <div class="flex items-center gap-2 text-xs font-mono text-zero-black/70 flex-wrap">
              <span class="text-zero-red font-bold uppercase">Intervistati / Protagonisti:</span>
              <span class="font-bold text-zero-black">
                {post.interviewees.map((int: any) => `${int.name}${int.roleOrContext ? ` (${int.roleOrContext})` : ''}`).join(' • ')}
              </span>
            </div>
          )}

          {(post.authorInfo || post.author) && (
            <div class="flex items-center gap-2 text-xs font-mono text-zero-black/70 flex-wrap">
              <span class="text-zero-red font-bold uppercase">Autore / Ricerca:</span>
              <span class="font-bold text-zero-black">
                {post.authorInfo ? `${post.authorInfo.name} ${post.authorInfo.roleOrContext ? `(${post.authorInfo.roleOrContext})` : ''}` : post.author}
              </span>
            </div>
          )}
        </div>
      </div>
    </header>

    <!-- 2. CORPO ARTICOLO: RITMO [TESTO] [FOTO] [TESTO] [APPROFONDIMENTO] [TESTO] [FOTO] ... [AUTORI] -->
    <main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12 md:py-20 space-y-16 md:space-y-24">
      
      <!-- Foto Copertina Iniziale -->
      {post.coverImageUrl && (
        <figure class="w-full overflow-hidden shadow-sm gsap-fade-up">
          <img
            src={post.coverImageUrl}
            alt={`Copertina articolo: ${post.title}`}
            itemprop="image"
            class="w-full max-h-[70vh] object-cover"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
          {post.coverMedia?.caption && (
            <figcaption class="p-3 bg-zero-paper ui-meta text-zero-black text-xs text-center border-t border-neutral-200/40">
              {post.coverMedia.caption}
            </figcaption>
          )}
        </figure>
      )}

      <!-- Sezione Video Embed opzionale -->
      {videoEmbedUrl && (
        <div class="w-full aspect-video shadow-sm overflow-hidden gsap-fade-up">
          <iframe
            src={videoEmbedUrl}
            title={`Video: ${post.title}`}
            class="w-full h-full border-0"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
          />
        </div>
      )}

      <!-- Sequenza Dinamica dei Blocchi di Contenuto -->
      <div itemprop="articleBody" class="space-y-10 md:space-y-12 gsap-fade-up">
        {hasStructuredBlocks ? (
          post.contentBlocks!.map((block, idx) => {
            if (block.type === 'text') {
              const htmlContent = renderBlockHtml(block, idx === 0);
              const hasDropCapMarkup = htmlContent.includes('float-left');
              const shouldApplyAutoDropCap = idx === 0 && !hasDropCapMarkup && !block.heading;
              return (
                <div class="space-y-4">
                  {block.heading && (
                    <h2 class="font-display font-bold text-2xl md:text-3xl text-zero-black uppercase tracking-tight pt-4">
                      {block.heading}
                    </h2>
                  )}
                  {htmlContent && (
                    <p
                      class={`text-lg md:text-xl font-helvetica font-normal text-zero-black leading-relaxed text-justify hyphens-auto ${shouldApplyAutoDropCap ? 'first-letter:float-left first-letter:text-6xl first-letter:font-display first-letter:font-bold first-letter:mr-4 first-letter:text-zero-red first-letter:leading-none first-letter:mt-1' : ''}`}
                      set:html={htmlContent}
                    />
                  )}
                </div>
              );
            }

            if (block.type === 'image') {
              return (
                <figure class="w-full my-10 overflow-hidden shadow-sm">
                  <img
                    src={block.url}
                    alt={block.alt || `Fotografia documentaria per ${post.title}`}
                    class="w-full max-h-[65vh] object-cover"
                    loading="lazy"
                    decoding="async"
                  />
                  {block.caption && (
                    <figcaption class="p-3 bg-zero-paper ui-meta text-zero-black text-xs text-center border-t border-neutral-200/40">
                      {block.caption}
                    </figcaption>
                  )}
                </figure>
              );
            }

            if (block.type === 'didascalia' || (block as any).type === 'approfondimento') {
              return (
                <aside class="my-10 p-6 md:p-8 bg-zero-paper border-l-4 border-zero-red shadow-sm space-y-2">
                  {block.title && (
                    <div class="flex items-center gap-2">
                      <span class="font-mono text-xs uppercase font-bold text-zero-red tracking-wider">APPROFONDIMENTO •</span>
                      <h3 class="font-display font-bold text-base md:text-lg uppercase text-zero-black tracking-tight">
                        {block.title}
                      </h3>
                    </div>
                  )}
                  <p class="text-base md:text-lg font-helvetica font-normal text-zero-black leading-relaxed whitespace-pre-line">
                    {block.text}
                  </p>
                </aside>
              );
            }

            if (block.type === 'quote' || (block as any).type === 'pullQuote') {
              return (
                <div class="my-12 py-6 border-y border-neutral-200/80 text-center max-w-3xl mx-auto space-y-2">
                  <p class="font-display font-black text-2xl sm:text-3xl md:text-4xl uppercase text-zero-black leading-tight tracking-tight text-balance">
                    {block.quote}
                  </p>
                  {(block as any).author && (
                    <p class="font-mono text-xs text-zero-red font-bold uppercase tracking-wider">
                      — {(block as any).author}
                    </p>
                  )}
                </div>
              );
            }

            if (block.type === 'editorialDivider') {
              if (block.style === 'thinLine') {
                return <div class="my-10 border-t border-neutral-300 w-full"></div>;
              }
              if (block.style === 'dots') {
                return <div class="my-10 text-center text-zero-red font-mono text-xl tracking-[12px] select-none">•••</div>;
              }
              if (block.style === 'space') {
                return <div class="my-12"></div>;
              }
              return <div class="my-10 h-0.5 bg-zero-red w-full"></div>;
            }

            return null;
          })
        ) : fallbackPairs.length > 0 ? (
          fallbackPairs.map((pair, idx) => (
            <div class="space-y-8">
              <p class={`text-lg md:text-xl font-helvetica font-normal text-zero-black leading-relaxed text-justify hyphens-auto ${idx === 0 ? 'first-letter:float-left first-letter:text-6xl first-letter:font-display first-letter:font-bold first-letter:mr-4 first-letter:text-zero-red first-letter:leading-none first-letter:mt-1' : ''}`}>
                {pair.text}
              </p>
              {pair.image && (
                <figure class="w-full overflow-hidden shadow-sm my-8">
                  <img
                    src={pair.image}
                    alt={`Scatto documentario ${idx + 1} per ${post.title}`}
                    class="w-full max-h-[60vh] object-cover"
                    loading="lazy"
                    decoding="async"
                  />
                </figure>
              )}
            </div>
          ))
        ) : (
          <p class="text-lg font-light text-zero-black leading-relaxed">
            Contenuto editoriale in corso di caricamento.
          </p>
        )}
      </div>

      <!-- 3. SEZIONE FINALE: [AUTORI] -->
      <section class="mt-16 pt-10 border-t border-neutral-300/80 space-y-4 gsap-fade-up" aria-label="Autori e crediti reportage">
        <div class="flex items-center gap-2">
          <span class="w-2 h-2 bg-zero-red rounded-full"></span>
          <h2 class="font-mono font-bold text-xs uppercase tracking-widest text-zero-red">
            AUTORI & CREDITI REPORTAGE
          </h2>
        </div>

        <div class="p-6 md:p-8 bg-zero-paper border border-neutral-200/70 shadow-sm flex flex-col sm:flex-row sm:items-center justify-between gap-6">
          <div class="space-y-1.5">
            <div class="font-display font-bold text-xl md:text-2xl uppercase text-zero-black tracking-tight">
              {post.authorInfo?.name || post.author || "Redazione VERACE"}
            </div>
            {post.authorInfo?.roleOrContext && (
              <p class="font-mono text-xs text-neutral-600">
                {post.authorInfo.roleOrContext}
              </p>
            )}
            {post.authorInfo?.photography && (
              <p class="font-mono text-xs text-neutral-600">
                Fotografie: <span class="text-zero-black font-bold">{post.authorInfo.photography}</span>
              </p>
            )}
          </div>
          
          {(post.authorInfo?.credits || post.credits) && (
            <div class="font-mono text-xs text-neutral-500 max-w-xs text-left sm:text-right border-t sm:border-t-0 pt-3 sm:pt-0 border-neutral-200/60">
              {post.authorInfo?.credits || post.credits}
            </div>
          )}
        </div>
      </section>

      <!-- 4. GALLERIA FOTOGRAFICA IN FONDO -->
      {galleryImages.length > 0 && (
        <section class="mt-16 pt-12 space-y-6 gsap-fade-up border-t border-neutral-200" aria-label="Galleria dell'articolo">
          <div class="flex items-center justify-between">
            <h2 class="font-display font-bold text-2xl md:text-3xl uppercase text-zero-black">
              Galleria Fotografica
            </h2>
            
            <div class="flex items-center gap-2">
              <button
                id="carousel-prev"
                class="w-10 h-10 bg-zero-paper shadow-sm text-zero-black hover:bg-zero-red hover:text-white flex items-center justify-center font-bold transition-colors focus:outline-none"
                aria-label="Foto precedente"
              >
                ←
              </button>
              <button
                id="carousel-next"
                class="w-10 h-10 bg-zero-paper shadow-sm text-zero-black hover:bg-zero-red hover:text-white flex items-center justify-center font-bold transition-colors focus:outline-none"
                aria-label="Foto successiva"
              >
                →
              </button>
            </div>
          </div>

          <div
            id="article-gallery-carousel"
            class="flex items-center gap-4 overflow-x-auto scroll-smooth snap-x snap-mandatory py-2 no-scrollbar"
          >
            {galleryImages.map((imgUrl, index) => (
              <div
                class="snap-start shrink-0 w-[85%] sm:w-[55%] md:w-[45%] lg:w-[38%] aspect-[4/3] relative overflow-hidden group cursor-pointer gallery-item shadow-sm"
                data-index={index}
                data-img-url={imgUrl}
              >
                <img
                  src={imgUrl}
                  alt={`Scatto ${index + 1} per l'articolo: ${post.title}`}
                  class="w-full h-full object-cover transition-transform duration-500 ease-out group-hover:scale-105"
                  loading="lazy"
                  decoding="async"
                />
                <div class="absolute bottom-3 left-3 bg-zero-paper px-2.5 py-0.5 ui-meta text-zero-black font-bold text-xs shadow-sm">
                  {index + 1} / {galleryImages.length}
                </div>
                <div class="absolute top-3 right-3 bg-black/60 text-white p-1.5 opacity-0 group-hover:opacity-100 transition-opacity">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v6m3-3H7"/></svg>
                </div>
              </div>
            ))}
          </div>
        </section>
      )}

      <!-- Condivisione e Navigazione Bottom -->
      <div class="mt-16 pt-8 flex flex-col sm:flex-row items-center justify-between gap-6 gsap-fade-up">
        <a href="/magazine" class="ui-meta font-bold text-zero-black hover:text-zero-red transition-colors">
          ← TORNA AL MAGAZINE
        </a>
        <div class="flex items-center gap-4">
          <button
            onclick="navigator.clipboard.writeText(window.location.href); alert('Link dell\'articolo copiato negli appunti!');"
            class="px-6 py-3.5 bg-zero-paper text-zero-black ui-meta font-bold hover:bg-zero-red hover:text-white transition-colors shadow-sm"
          >
            CONDIVIDI ARTICOLO
          </button>
          <a href="/contatti" class="px-6 py-3.5 bg-zero-black text-white ui-meta font-bold hover:bg-zero-red transition-colors shadow-sm">
            PROPOSTA EDITORIALE
          </a>
        </div>
      </div>

    </main>

    <!-- 5. SLIDER ORIZZONTALE TUTTI GLI ARTICOLI (IN MAX-WIDTH, SENZA RIQUADRI, CON SPAZIO GENEROSO) -->
    {suggestedPosts && suggestedPosts.length > 0 && (
      <section class="w-full max-w-[1600px] mx-auto px-4 sm:px-8 lg:px-12 my-20 md:my-32 pt-12 md:pt-16 border-t border-neutral-300/80 space-y-8 gsap-fade-up" aria-label="Slider articoli del magazine">
        <div class="flex items-end justify-between flex-wrap gap-4">
          <div>
            <div class="flex items-center gap-2">
            </div>
            <h2 class="font-display font-bold text-2xl sm:text-3xl lg:text-4xl uppercase text-zero-black tracking-tight mt-1">
              Articoli suggeriti dal Magazine
            </h2>
          </div>

          <!-- Frecce di navigazione dello slider e link archivio -->
          <div class="flex items-center gap-3">
            <a href="/magazine" class="hidden sm:inline-block ui-meta font-bold text-xs text-zero-black hover:text-zero-red transition-colors mr-2">
              TUTTO IL MAGAZINE →
            </a>
            <button
              id="suggested-prev"
              class="w-10 h-10 bg-zero-paper shadow-sm text-zero-black hover:bg-zero-red hover:text-white flex items-center justify-center font-bold transition-colors focus:outline-none cursor-pointer"
              aria-label="Articolo precedente nello slider"
            >
              ←
            </button>
            <button
              id="suggested-next"
              class="w-10 h-10 bg-zero-paper shadow-sm text-zero-black hover:bg-zero-red hover:text-white flex items-center justify-center font-bold transition-colors focus:outline-none cursor-pointer"
              aria-label="Articolo successivo nello slider"
            >
              →
            </button>
          </div>
        </div>

        <!-- Traccia orizzontale a scorrimento (senza bordi né box spuri, con spaziatura aumentata) -->
        <div
          id="suggested-articles-slider"
          class="flex items-stretch gap-8 sm:gap-10 md:gap-12 lg:gap-14 overflow-x-auto scroll-smooth snap-x snap-mandatory py-4 px-1 no-scrollbar"
        >
          {suggestedPosts.map((suggested) => (
            <div class="snap-start shrink-0 w-[84%] sm:w-[48%] md:w-[38%] lg:w-[30%] xl:w-[26%] flex flex-col">
              <ArticleCard post={suggested} />
            </div>
          ))}
        </div>
      </section>
    )}
  </article>

  <!-- Lightbox Modal for Photo Gallery -->
  {galleryImages.length > 0 && (
    <div
      id="lightbox-modal"
      class="fixed inset-0 z-50 flex items-center justify-center bg-black/90 backdrop-blur-md hidden p-4 sm:p-8"
      role="dialog"
      aria-modal="true"
      aria-label="Visualizzatore galleria fotografica a schermo intero"
    >
      <button
        id="lightbox-close"
        class="absolute top-4 right-4 z-30 text-white bg-black/70 hover:bg-zero-red p-3 transition-colors focus:outline-none cursor-pointer"
        aria-label="Chiudi galleria"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>

      <button
        id="lightbox-prev"
        class="absolute left-4 top-1/2 -translate-y-1/2 z-30 text-white bg-black/70 hover:bg-zero-red p-3 sm:p-4 transition-colors focus:outline-none cursor-pointer"
        aria-label="Immagine precedente"
      >
        <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
      </button>

      <button
        id="lightbox-next"
        class="absolute right-4 top-1/2 -translate-y-1/2 z-30 text-white bg-black/70 hover:bg-zero-red p-3 sm:p-4 transition-colors focus:outline-none cursor-pointer"
        aria-label="Immagine successiva"
      >
        <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
      </button>

      <div class="max-w-5xl max-h-[85vh] relative flex flex-col items-center">
        <img
          id="lightbox-img"
          src=""
          alt="Ingrandimento fotografia"
          class="max-w-full max-h-[80vh] object-contain shadow-2xl"
        />
        <div id="lightbox-caption" class="mt-3 text-white/80 ui-meta text-xs tracking-wider text-center"></div>
      </div>
    </div>
  )}
</BaseLayout>

<script>
  function initArticleGallery() {
    const prevBtn = document.getElementById('carousel-prev');
    const nextBtn = document.getElementById('carousel-next');
    const carousel = document.getElementById('article-gallery-carousel');
    const galleryItems = document.querySelectorAll<HTMLElement>('.gallery-item');
    const lightboxModal = document.getElementById('lightbox-modal');
    const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement | null;
    const lightboxCaption = document.getElementById('lightbox-caption');
    const lightboxClose = document.getElementById('lightbox-close');
    const lightboxPrev = document.getElementById('lightbox-prev');
    const lightboxNext = document.getElementById('lightbox-next');

    let currentLightboxIndex = 0;
    const images: string[] = [];

    galleryItems.forEach((item) => {
      const url = item.getAttribute('data-img-url');
      if (url) images.push(url);
    });

    if (prevBtn && carousel) {
      prevBtn.addEventListener('click', () => {
        carousel.scrollBy({ left: -320, behavior: 'smooth' });
      });
    }

    if (nextBtn && carousel) {
      nextBtn.addEventListener('click', () => {
        carousel.scrollBy({ left: 320, behavior: 'smooth' });
      });
    }

    // Slider Articoli Suggeriti (Tutti gli articoli del magazine)
    const suggestedPrev = document.getElementById('suggested-prev');
    const suggestedNext = document.getElementById('suggested-next');
    const suggestedSlider = document.getElementById('suggested-articles-slider');

    if (suggestedPrev && suggestedSlider) {
      suggestedPrev.addEventListener('click', () => {
        const scrollAmount = Math.max(340, suggestedSlider.clientWidth * 0.75);
        suggestedSlider.scrollBy({ left: -scrollAmount, behavior: 'smooth' });
      });
    }

    if (suggestedNext && suggestedSlider) {
      suggestedNext.addEventListener('click', () => {
        const scrollAmount = Math.max(340, suggestedSlider.clientWidth * 0.75);
        suggestedSlider.scrollBy({ left: scrollAmount, behavior: 'smooth' });
      });
    }

    function openLightbox(index: number) {
      if (!lightboxModal || !lightboxImg || images.length === 0) return;
      currentLightboxIndex = index;
      lightboxImg.src = images[currentLightboxIndex];
      if (lightboxCaption) {
        lightboxCaption.textContent = `Scatto ${currentLightboxIndex + 1} di ${images.length}`;
      }
      lightboxModal.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
    }

    function closeLightbox() {
      if (!lightboxModal) return;
      lightboxModal.classList.add('hidden');
      document.body.style.overflow = '';
    }

    function showNextLightbox() {
      if (images.length === 0) return;
      currentLightboxIndex = (currentLightboxIndex + 1) % images.length;
      if (lightboxImg) lightboxImg.src = images[currentLightboxIndex];
      if (lightboxCaption) {
        lightboxCaption.textContent = `Scatto ${currentLightboxIndex + 1} di ${images.length}`;
      }
    }

    function showPrevLightbox() {
      if (images.length === 0) return;
      currentLightboxIndex = (currentLightboxIndex - 1 + images.length) % images.length;
      if (lightboxImg) lightboxImg.src = images[currentLightboxIndex];
      if (lightboxCaption) {
        lightboxCaption.textContent = `Scatto ${currentLightboxIndex + 1} di ${images.length}`;
      }
    }

    galleryItems.forEach((item) => {
      item.addEventListener('click', () => {
        const idx = parseInt(item.getAttribute('data-index') || '0', 10);
        openLightbox(idx);
      });
    });

    if (lightboxClose) lightboxClose.addEventListener('click', closeLightbox);
    if (lightboxNext) lightboxNext.addEventListener('click', showNextLightbox);
    if (lightboxPrev) lightboxPrev.addEventListener('click', showPrevLightbox);

    if (lightboxModal) {
      lightboxModal.addEventListener('click', (e) => {
        if (e.target === lightboxModal) closeLightbox();
      });
    }

    document.addEventListener('keydown', (e) => {
      if (lightboxModal && !lightboxModal.classList.contains('hidden')) {
        if (e.key === 'Escape') closeLightbox();
        if (e.key === 'ArrowRight') showNextLightbox();
        if (e.key === 'ArrowLeft') showPrevLightbox();
      }
    });
  }

  document.addEventListener('DOMContentLoaded', initArticleGallery);
  document.addEventListener('astro:page-load', initArticleGallery);
</script>
